import Mathlib.Data.Fintype.Basic
import Mathlib.Tactic.Linarith

namespace CazenaveRank
set_option autoImplicit false

def scale : ℕ := 100000

def lowTable : Array ℕ := #[0, 100000, 141421, 173205, 200000, 223606, 244948, 264575, 282842, 300000, 316227, 331662, 346410, 360555, 374165, 387298, 400000, 412310, 424264, 435889, 447213, 458257, 469041, 479583, 489897, 500000, 509901, 519615, 529150, 538516, 547722, 556776, 565685, 574456, 583095, 591607, 600000, 608276, 616441, 624499, 632455, 640312, 648074, 655743, 663324, 670820, 678232, 685565, 692820, 700000, 707106, 714142, 721110, 728010, 734846, 741619, 748331, 754983, 761577, 768114, 774596, 781024, 787400, 793725, 800000, 806225, 812403, 818535, 824621, 830662, 836660, 842614, 848528, 854400, 860232, 866025, 871779, 877496, 883176, 888819, 894427, 900000, 905538, 911043, 916515, 921954, 927361, 932737, 938083, 943398, 948683, 953939, 959166, 964365, 969535, 974679, 979795, 984885, 989949, 994987, 1000000, 1004987, 1009950, 1014889, 1019803, 1024695, 1029563, 1034408, 1039230, 1044030, 1048808, 1053565, 1058300, 1063014, 1067707, 1072380, 1077032, 1081665, 1086278, 1090871, 1095445, 1100000, 1104536, 1109053, 1113552, 1118033, 1122497, 1126942, 1131370, 1135781, 1140175, 1144552, 1148912, 1153256, 1157583, 1161895, 1166190, 1170469, 1174734, 1178982, 1183215, 1187434, 1191637, 1195826, 1200000, 1204159, 1208304, 1212435, 1216552, 1220655, 1224744, 1228820, 1232882, 1236931, 1240967, 1244989, 1248999, 1252996, 1256980, 1260952, 1264911, 1268857, 1272792, 1276714, 1280624, 1284523, 1288409, 1292284, 1296148, 1300000, 1303840, 1307669, 1311487, 1315294, 1319090, 1322875, 1326649, 1330413, 1334166, 1337908, 1341640]

def iLow (k : ℕ) : ℕ := lowTable[k]?.getD 0
def iHi (k : ℕ) : ℕ := iLow k+1

def dSmall (n p : ℕ) : ℕ := if p=0 then n-1 else n-p

def intClaim (n p : ℕ) : Prop :=
  let d := dSmall n p
  let a := iLow (2*d)
  let e := iHi d
  let cl := iLow 2
  let cu := iHi 2
  let u := iHi n
  2*e*(n-p)*a + 2*scale*p*(scale*(d+2)-cu) >
    ((3*u-3*cl)+2*scale)*(d+2)*e

instance (n p : ℕ) : Decidable (intClaim n p) := by unfold intClaim; infer_instance

set_option maxRecDepth 10000 in
set_option maxHeartbeats 15000000 in
theorem lowTable_sound (k : Fin 181) :
    (iLow k.val)^2 ≤ k.val*scale*scale ∧ k.val*scale*scale < (iHi k.val)^2 :=
  (show ∀ k : Fin 181, (iLow k.val)^2 ≤ k.val*scale*scale ∧ k.val*scale*scale < (iHi k.val)^2 by decide) k


#print axioms lowTable_sound
end CazenaveRank
