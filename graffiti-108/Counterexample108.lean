def bits (u : V) : Nat := triples[u.val]!
theorem triplesExact : triples.toList.Perm
    ((List.range 128).filter (fun m => (List.range 7).countP m.testBit == 3)) := by decide

def edge (u v : V) : Bool := (bits u &&& bits v) == 0
def Independent (s : V → Bool) : Prop :=
  ∀ u v, s u = true → s v = true → edge u v = false
def size (s : V → Bool) : Nat := vertices.countP s
def Maximum (s : V → Bool) : Prop :=
  Independent s ∧ ∀ t, Independent t → size t ≤ size s
def core (v : V) : Prop := ∀ s, Maximum s → s v = true

theorem simple : (∀ u, edge u u = false) ∧ (∀ u v, edge u v = edge v u) := by decide

def cycle1 : List V := [0,31,4,25,14,15,34]
def cycle2 : List V := [1,28,11,16,33,2,30]
def cycle3 : List V := [3,27,22,8,19,7,32]
def cycle4 : List V := [6,20,29,10,18,12,21]
def cycle5 : List V := [5,23,26,13,17,9,24]

theorem partition : vertices.Perm (cycle1 ++ cycle2 ++ cycle3 ++ cycle4 ++ cycle5) := by decide

def cycleOk : List V → Bool
  | [a,b,c,d,e,f,g] => edge a b && edge b c && edge c d && edge d e &&
                        edge e f && edge f g && edge g a
  | _ => false

private theorem sevenBits :
    ∀ a b c d e f g : Bool,
    ¬ (a = true ∧ b = true) → ¬ (b = true ∧ c = true) →
    ¬ (c = true ∧ d = true) → ¬ (d = true ∧ e = true) →
    ¬ (e = true ∧ f = true) → ¬ (f = true ∧ g = true) →
    ¬ (g = true ∧ a = true) → [a,b,c,d,e,f,g].countP id ≤ 3 := by decide

private theorem cycleBound (s : V → Bool) (hs : Independent s)
    (a b c d e f g : V) (h : cycleOk [a,b,c,d,e,f,g] = true) :
    [a,b,c,d,e,f,g].countP s ≤ 3 := by
  have hn (u v : V) (he : edge u v = true) : ¬ (s u = true ∧ s v = true) := by
    rintro ⟨hu,hv⟩
    rw [hs u v hu hv] at he
    contradiction
  simp only [cycleOk, Bool.and_eq_true] at h
  obtain ⟨⟨⟨⟨⟨⟨hab,hbc⟩,hcd⟩,hde⟩,hef⟩,hfg⟩,hga⟩ := h
  have h7 := sevenBits (s a) (s b) (s c) (s d) (s e) (s f) (s g)
    (hn _ _ hab) (hn _ _ hbc) (hn _ _ hcd) (hn _ _ hde) (hn _ _ hef) (hn _ _ hfg) (hn _ _ hga)
  simpa only [List.countP_cons, List.countP_nil, id] using h7

theorem alphaUpper (s : V → Bool) (h : Independent s) : size s ≤ 15 := by
  have h1 : cycle1.countP s ≤ 3 := cycleBound s h 0 31 4 25 14 15 34 (by decide)
  have h2 : cycle2.countP s ≤ 3 := cycleBound s h 1 28 11 16 33 2 30 (by decide)
  have h3 : cycle3.countP s ≤ 3 := cycleBound s h 3 27 22 8 19 7 32 (by decide)
  have h4 : cycle4.countP s ≤ 3 := cycleBound s h 6 20 29 10 18 12 21 (by decide)
  have h5 : cycle5.countP s ≤ 3 := cycleBound s h 5 23 26 13 17 9 24 (by decide)
  unfold size
  rw [partition.countP_eq s]
  simp only [List.countP_append]
  omega

def star (i : Fin 7) (v : V) : Bool := (bits v).testBit i.val
theorem stars (i : Fin 7) : Independent (star i) ∧ size (star i) = 15 :=
  by
  constructor
  · unfold Independent
    exact (by decide : ∀ (i : Fin 7) (u v : V), star i u = true → star i v = true → edge u v = false) i
  · exact (by decide : ∀ i : Fin 7, size (star i) = 15) i

theorem starMaximum (i : Fin 7) : Maximum (star i) := by
  refine ⟨(stars i).1, fun t ht => ?_⟩
  rw [(stars i).2]
  exact alphaUpper t ht

theorem coreEmpty (v : V) : ¬ core v := by
  have h : ∀ v : V, (List.finRange 7).any (fun i => !star i v) = true := by decide
  obtain ⟨i,_,hi⟩ := List.any_eq_true.mp (h v)
  have hfalse : star i v = false := by simpa using hi
  intro hv
  have htrue := hv (star i) (starMaximum i)
  rw [hfalse] at htrue
  contradiction


def walk : Nat → V → V → Prop
  | 0, u, v => u = v
  | n+1, u, v => ∃ w : V, edge u w = true ∧ walk n w v

theorem allVertices : ∀ v : V, v ∈ vertices := by decide

theorem walkOne (u v : V) : walk 1 u v ↔ edge u v = true := by
  constructor
  · rintro ⟨w,hw,rfl⟩
    exact hw
  · intro h
    exact ⟨v,h,rfl⟩

def hasTwo (u v : V) : Bool := vertices.any (fun w => edge u w && edge w v)

theorem walkTwo (u v : V) : walk 2 u v ↔ hasTwo u v = true := by
  constructor
  · rintro ⟨w,hw,hwv⟩
    apply List.any_eq_true.mpr
    refine ⟨w,allVertices w,?_⟩
    simp only [Bool.and_eq_true]
    exact ⟨hw,(walkOne w v).mp hwv⟩
  · intro h
    obtain ⟨w,_,hw⟩ := List.any_eq_true.mp h
    simp only [Bool.and_eq_true] at hw
    obtain ⟨hu,hv⟩ := hw
    exact ⟨w,hu,(walkOne w v).mpr hv⟩

def distance (u v : V) : Nat :=
  if u = v then 0 else if edge u v then 1 else if hasTwo u v then 2 else 3

def route (u v : V) : V × V :=
  let p := routes[u.val]![v.val]!
  (⟨p.1 % 35, Nat.mod_lt _ (by decide)⟩, ⟨p.2 % 35, Nat.mod_lt _ (by decide)⟩)

set_option maxRecDepth 8192 in
set_option maxHeartbeats 3500000 in
theorem routeOK : ∀ u v : V, distance u v = 3 →
  edge u (route u v).1 = true ∧ edge (route u v).1 (route u v).2 = true ∧
  edge (route u v).2 v = true := by decide

theorem shortest (u v : V) :
    walk (distance u v) u v ∧ ∀ k, walk k u v → distance u v ≤ k := by
  by_cases h0 : u = v
  · simp [distance, h0, walk]
  by_cases h1 : edge u v = true
  · have hd : distance u v = 1 := by simp [distance,h0,h1]
    rw [hd]
    refine ⟨(walkOne u v).mpr h1, ?_⟩
    intro k hk
    cases k with
    | zero => exact False.elim (h0 hk)
    | succ k => omega
  by_cases h2 : hasTwo u v = true
  · have hd : distance u v = 2 := by simp [distance,h0,h1,h2]
    rw [hd]
    refine ⟨(walkTwo u v).mpr h2, ?_⟩
    intro k hk
    by_cases h : 2 ≤ k
    · exact h
    have hh : k = 0 ∨ k = 1 := by omega
    rcases hh with rfl | rfl
    · exact False.elim (h0 hk)
    · exact False.elim (h1 ((walkOne u v).mp hk))
  · have hd : distance u v = 3 := by simp [distance,h0,h1,h2]
    obtain ⟨ha,hb,hc⟩ := routeOK u v hd
    rw [hd]
    refine ⟨⟨_,ha,_,hb,(walkOne _ _).mpr hc⟩, ?_⟩
    intro k hk
    by_cases h : 3 ≤ k
    · exact h
    have hh : k = 0 ∨ k = 1 ∨ k = 2 := by omega
    rcases hh with rfl | rfl | rfl
    · exact False.elim (h0 hk)
    · exact False.elim (h1 ((walkOne u v).mp hk))
    · exact False.elim (h2 ((walkTwo u v).mp hk))

def evenCount (u : V) := vertices.countP (fun v => distance u v % 2 == 0)

set_option maxRecDepth 8192 in
set_option maxHeartbeats 4000000 in
theorem evens : ∀ u : V, evenCount u = 13 := by decide

/-- The attained independence number is 15; every vertex is excluded by some
maximum independent set. All shortest even-distance balls have size 13. -/
theorem counterexample :
    (∀ u v, ∃ k, walk k u v) ∧
    (∃ s, Maximum s ∧ size s = 15) ∧
    (∀ v, ¬ core v) ∧ (∀ u, evenCount u = 13) ∧
    13 + 2 * (0 / 3) < 15 :=
  ⟨fun u v => ⟨distance u v,(shortest u v).1⟩,
   ⟨star 0, starMaximum 0, (stars 0).2⟩,coreEmpty,evens,by decide⟩

#print axioms counterexample
end Graffiti108
