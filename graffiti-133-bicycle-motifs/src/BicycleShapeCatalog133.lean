private theorem positive : 1≤outerOrder := by decide

theorem canonical_rows :
    (∀ i j : Fin outerOrder, relabel labeling positive i = relabel labeling positive j → i=j) ∧
    (∀ i j : Fin outerOrder, bit rows i.val j.val =
      thetaRelation 1 4 4 (relabel labeling positive i).val (relabel labeling positive j).val) := by decide

#print axioms canonical_rows
end Theta144

