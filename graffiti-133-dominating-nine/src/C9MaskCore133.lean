def cycRaw (i j : Nat) : Bool :=
  decide (i+1=j ∨ j+1=i ∨ (i=0 ∧ j+1=9) ∨ (j=0 ∧ i+1=9))

def doubleRaw (a b : Nat) (e : Bool) (i j : Nat) : Bool :=
  if i < 9 then
    if j < 9 then cycRaw i j else if j = 9 then a.testBit i else b.testBit i
  else if j < 9 then
    if i = 9 then a.testBit j else b.testBit j
  else
    if i = j then false else e

theorem doubleRaw_correct (a b : Nat) (e : Bool) (i j : Fin 11) :
    doubleRaw a b e i.val j.val = true ↔ Double a b e i j := by
  fin_cases i <;> fin_cases j <;>
    simp [doubleRaw,Double,ext,Single,msecond,maskBit,cycRaw,Cyclic]

def fastDecode (w i : Nat) := digit w i % 11

def fastWitnessOK (A : Nat → Nat → Bool) (pass : Bool) (w : Nat) : Bool :=
  if digit w 0 = 0 then pass else
  if digit w 0 = 1 then
    let i := fastDecode w 1
    let j := fastDecode w 2
    let a := fastDecode w 3
    let b := fastDecode w 4
    (i != j) && (a != b) && A i a && A j a && A i b && A j b
  else
    let p := fun i => fastDecode w (i+1)
    (List.range 9).all fun i =>
      (List.range 9).all fun j =>
        if i<j then (p i != p j) && (A (p i) (p j) == (i+1==j)) else true

theorem fastWitness_sound (a b : Nat) (e pass : Bool) (w : Nat)
    (hw : fastWitnessOK (doubleRaw a b e) pass w = true) (hg : Good9 (Double a b e)) :
    pass = true := by
  unfold fastWitnessOK at hw
  split at hw
  · exact hw
  · split at hw
    · simp only [Bool.and_eq_true, bne_iff_ne] at hw
      obtain ⟨⟨⟨⟨⟨ij,ab⟩,ia⟩,ja⟩,ib⟩,jb⟩ := hw
      exact (hg.h4 (decode (n:=10) w 1) (decode w 2) (decode w 3) (decode w 4)
        (fun x=>ij (congrArg Fin.val x)) (fun x=>ab (congrArg Fin.val x))
        ((doubleRaw_correct ..).mp ia) ((doubleRaw_correct ..).mp ja)
        ((doubleRaw_correct ..).mp ib) ((doubleRaw_correct ..).mp jb)).elim
    · let p : Fin 9 → Fin 11 := fun i => decode w (i.val+1)
      have row (i j : Fin 9) (lt : i<j) :
          p i ≠ p j ∧ (doubleRaw a b e (p i).val (p j).val = true ↔ i.val+1=j.val) := by
        have z := List.all_eq_true.mp
          (List.all_eq_true.mp hw i.val (List.mem_range.mpr i.isLt)) j.val (List.mem_range.mpr j.isLt)
        have klt : i.val < j.val := lt
        rw [if_pos klt] at z
        have zz := (Iff.of_eq (Bool.and_eq_true _ _)).mp z
        refine ⟨fun ne => ?_,?_⟩
        · exact (bne_iff_ne.mp zz.1) (congrArg Fin.val ne)
        · change (doubleRaw a b e (fastDecode w (i.val+1)) (fastDecode w (j.val+1)) = true ↔ i.val+1=j.val)
          have eq := beq_iff_eq.mp zz.2
          rw [eq]
          simp
      apply (hg.h9 p ?_ (fun i j h => (doubleRaw_correct ..).symm.trans (row i j h).2)).elim
      intro i j eq
      rcases lt_trichotomy i j with lt | same | gt
      · exact ((row i j lt).1 eq).elim
      · exact same
      · exact ((row j i gt).1 eq.symm).elim

#print axioms fastWitness_sound
