def singleTest (m : Nat) : Bool :=
  witnessOK (Single m) (m==0 || masks.contains m) (singleW.getD m 0)

def pairTest (i j : Nat) (e : Bool) : Bool :=
  fastWitnessOK (doubleRaw (masks.getD i 0) (masks.getD j 0) e)
    ((i==j) || (okPair i j && (!e || mayEdge i j)))
    (((doubleW e).getD i []).getD j 0)

set_option maxRecDepth 150000
set_option maxHeartbeats 0

theorem singleTests : (List.range 512).all singleTest = true := by decide

def pairRange (i : Nat) : Bool :=
  (List.range 57).all fun j => pairTest i j false && pairTest i j true


#print axioms singleTests
end Graffiti133C9
namespace Graffiti133C9
open SimpleGraph Graffiti133 Graffiti133NoFive Graffiti133P8Heawood Graffiti133Eighth
set_option linter.unusedSectionVars false

def profileMask (i : Fin 57) : Nat := masks.getD i.val 0
def profileContacts (i : Fin 57) : Finset (Fin 9) :=
  Finset.univ.filter (fun k => maskBit (profileMask i) k = true)
def profileOK (i j : Fin 57) : Prop := okPair i.val j.val = true
def profileEdge (i j : Fin 57) : Prop := mayEdge i.val j.val = true
instance : DecidableRel profileOK := fun _ _ => inferInstanceAs (Decidable (_=_))
instance : DecidableRel profileEdge := fun _ _ => inferInstanceAs (Decidable (_=_))

theorem profile_at_least_two : ∀ i : Fin 57, 2 ≤ (profileContacts i).card := by decide
theorem profile_at_most_four : ∀ i : Fin 57, (profileContacts i).card ≤ 4 := by decide

variable {V : Type*} [Fintype V] {G : SimpleGraph V}
def Matches (H : Hole G 9) (v : V) (i : Fin 57) : Prop :=
  ∀ k, G.Adj v (H.c k) ↔ k∈profileContacts i

private def modelOfHole (H : Hole G 9) : Model G (@Cyclic 9) := ⟨H.c,H.inj,fun i j => (H.adj i j).symm⟩

private theorem matches_mask {H : Hole G 9} {v : V} {i : Fin 57} (h : Matches H v i) :
    ∀ k, maskBit (profileMask i) k = true ↔ G.Adj v (H.c k) := by
  intro k
  simpa [profileContacts] using (h k).symm

theorem classify_profile (H : Hole G 9) (h4 : FourCycleFree G)
    (h9 : ¬∃ f : Fin 9 → V, InducedPath G f) (x : V) (hx : Outside H.c x)
    (n : ∃ k, G.Adj x (H.c k)) : ∃ i, Matches H x i := by
  classical
  let M := modelOfHole H
  let b := M.contacts x
  let m := encode 9 b
  have mz : m<512 := encode_bound 9 b
  have same : ∀ i, maskBit m i = true ↔ G.Adj x (M.f i) := by
    intro i
    exact (congrArg (· = true) (encode_correct 9 b i)).to_iff.trans (M.contacts_true x i)
  let N : Model G (Single m) := M.extend x hx same
  have ok := List.all_eq_true.mp singleTests m (List.mem_range.mpr mz)
  have Hmem := witnessOK_sound (Single m) (m==0 || masks.contains m) (singleW.getD m 0)
      ok (modelGood9 N h4 h9)
  have non : m ≠ 0 := by
    intro e
    obtain ⟨i,hi⟩ := n
    have it := (same i).mpr hi
    simp [e,maskBit] at it
  have mem : m ∈ masks := by simpa [non] using Hmem
  obtain ⟨p,hp,ep⟩ := List.getElem_of_mem mem
  have len : masks.length = 57 := by decide
  let i : Fin 57 := ⟨p,len ▸ hp⟩
  have e : profileMask i = m := by simpa [profileMask,i,hp] using ep
  refine ⟨i,fun k => ?_⟩
  rw [profileContacts, Finset.mem_filter]
  simpa [e] using (same k).symm

theorem classify_pair (H : Hole G 9) (h4 : FourCycleFree G)
    (h9 : ¬∃ f : Fin 9 → V, InducedPath G f)
    (test : ∀ i j : Fin 57, ∀ e, pairTest i.val j.val e = true)
    {x y : V} (freshX : Outside H.c x) (freshY : Outside H.c y) (xy : x ≠ y)
    {i j : Fin 57} (ij : i≠j) (hx : Matches H x i) (hy : Matches H y j) :
    profileOK i j ∧ (G.Adj x y → profileEdge i j) := by
  classical
  let M := modelOfHole H
  let N : Model G (Single (profileMask i)) := M.extend x freshX (matches_mask hx)
  let e : Bool := decide (G.Adj y x)
  have lastEq : N.f (Fin.last 9) = x := Model.extend_f_new ..
  have fresh : N.Fresh y := by
    intro k
    refine Fin.lastCases ?_ (fun k => ?_) k
    · simpa only [lastEq] using xy.symm
    · simpa [N,M,modelOfHole] using freshY k
  have edges : ∀ k, msecond (profileMask j) e k = true ↔ G.Adj y (N.f k) := by
    intro k
    refine Fin.lastCases ?_ (fun k => ?_) k
    · rw [lastEq]
      have hlt : ¬ (Fin.last 9 : Fin 10).val < 9 := by decide
      simp only [msecond,dif_neg hlt,e,decide_eq_true_eq]
    · simpa [msecond,N,M,modelOfHole] using matches_mask hy k
  let Q : Model G (Double (profileMask i) (profileMask j) e) := N.extend y fresh edges
  have out := fastWitness_sound (profileMask i) (profileMask j) e
    ((i.val==j.val) || (okPair i.val j.val && (!e || mayEdge i.val j.val)))
    (((doubleW e).getD i.val []).getD j.val 0) (test i j e) (modelGood9 Q h4 h9)
  have ne : i.val≠j.val := fun ee => ij (Fin.ext ee)
  have out' : okPair i.val j.val=true ∧ (e=false ∨ mayEdge i.val j.val=true) := by
    simpa [ne] using out
  refine ⟨out'.1,fun h => ?_⟩
  have he : e=true := by simp [e,h.symm]
  simpa [profileEdge,he] using out'.2

#print axioms classify_profile
#print axioms classify_pair
end Graffiti133C9
