import FirstBandFour133

namespace Graffiti133C9
open Finset

inductive CliqueCert where
  | color (colors : List Nat)
  | split (pivot : Nat) (without withPivot : CliqueCert)

def certOK (A : Nat → Nat → Bool) (L : List Nat) (k : Nat) : CliqueCert → Bool
  | .color c =>
    let col := fun i => c.getD i k
    L.all (fun i => decide (col i < k) &&
      L.all (fun j => (i == j) || !(A i j) || (col i != col j)))
  | .split v l r =>
    decide (0 < k) &&
      certOK A (L.filter (fun i => i != v)) k l &&
      certOK A (L.filter (fun i => (i != v) && A i v)) (k-1) r

theorem card_of_cliqueCert (A : Nat → Nat → Bool) (C : CliqueCert) (L : List Nat) (k : Nat)
    (ok : certOK A L k C = true) (S : Finset Nat)
    (mem : ∀ i∈S, i∈L) (clique : ∀ i∈S, ∀ j∈S, i≠j → A i j=true) : S.card ≤ k := by
  induction C generalizing L k S with
  | color c =>
    let col := fun i => c.getD i k
    apply (Finset.card_le_card_of_injOn (t := Finset.range k) col ?_ ?_).trans
    · simp
    · intro i hi
      have row := List.all_eq_true.mp ok i (mem i hi)
      exact Finset.mem_range.mpr (of_decide_eq_true ((Iff.of_eq (Bool.and_eq_true _ _)).mp row).1)
    · intro i hi j hj eq
      by_contra ne
      have row := List.all_eq_true.mp ok i (mem i hi)
      have colcert := List.all_eq_true.mp ((Iff.of_eq (Bool.and_eq_true _ _)).mp row).2 j (mem j hj)
      simp [ne,clique i hi j hj ne] at colcert
      exact colcert eq
  | split v left right ihl ihr =>
    have h := (Iff.of_eq (Bool.and_eq_true _ _)).mp ok
    have q := (Iff.of_eq (Bool.and_eq_true _ _)).mp h.1
    have pos : 0<k := of_decide_eq_true q.1
    by_cases hv : v∈S
    · have hr := ihr (L.filter (fun i => (i != v) && A i v)) (k-1) h.2 (S.erase v)
        (fun i hi => by
          obtain ⟨ne,hi⟩ := Finset.mem_erase.mp hi
          exact List.mem_filter.mpr ⟨mem i hi,by simp [ne,clique i hi v hv ne]⟩)
        (fun i hi j hj ne => clique i (Finset.mem_of_mem_erase hi) j (Finset.mem_of_mem_erase hj) ne)
      have hs := Finset.card_erase_add_one hv
      omega
    · exact ihl (L.filter (fun i => i != v)) k q.2 S
        (fun i hi => List.mem_filter.mpr ⟨mem i hi,by
          have ne : i≠v := fun e => hv (e ▸ hi)
          simp [ne]⟩) clique

#print axioms card_of_cliqueCert
end Graffiti133C9
