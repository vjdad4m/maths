def wTokens (i : Fin 57) : Finset Nat := (weightRows.getD i.val []).toFinset
def eToken (ij : Fin 57 × Fin 57) : Nat := ((edgeRows.getD ij.1.val []).getD ij.2.val 93)
def endsOf (t : Nat) : List Nat := TkEnds.getD t []
def supportOK (a b : Nat) : Bool :=
  (endsOf a).all (fun i => (endsOf b).all (fun j => (i==j) || okPair i j))

set_option maxRecDepth 150000
set_option maxHeartbeats 0

theorem wTokens_card : ∀ i : Fin 57, (wTokens i).card = (profileContacts i).card - 2 := by decide
theorem wTokens_ends_checked : ∀ i : Fin 57, (weightRows.getD i.val []).all
    (fun t => decide (t<93 ∧ endsOf t = [i.val])) = true := by decide

theorem wTokens_ends (i : Fin 57) (t : Nat) (ht : t∈weightRows.getD i.val []) :
    t<93 ∧ endsOf t = [i.val] := of_decide_eq_true (List.all_eq_true.mp (wTokens_ends_checked i) _ ht)

theorem eToken_ends : ∀ i j : Fin 57, i<j → profileEdge i j →
    eToken (i,j)<93 ∧ endsOf (eToken (i,j)) = [i.val,j.val] := by decide

theorem supportOK_sound : ∀ a b : Fin 93, a≠b → supportOK a.val b.val=true →
    tokenEdge a.val b.val=true := by decide

theorem profileOK_symm : ∀ i j : Fin 57, profileOK i j ↔ profileOK j i := by decide

theorem budget_direct (S : Finset (Fin 57))
    (pair : ∀ i∈S, ∀ j∈S, i<j → profileOK i j) :
    (∑ i∈S, ((profileContacts i).card-2)) +
      ((S ×ˢ S).filter (fun p => p.1<p.2 ∧ profileEdge p.1 p.2)).card ≤ 9 := by
  let F := (S ×ˢ S).filter (fun p => p.1<p.2 ∧ profileEdge p.1 p.2)
  let T := S.biUnion wTokens ∪ F.image eToken
  have w_ends {i : Fin 57} {t : Nat} (h : t∈wTokens i) :=
    wTokens_ends i t (List.mem_toFinset.mp h)
  have e_ends {p : Fin 57 × Fin 57} (h : p∈F) :
      eToken p < 93 ∧ endsOf (eToken p) = [p.1.val,p.2.val] :=
    eToken_ends _ _ (Finset.mem_filter.mp h).2.1 (Finset.mem_filter.mp h).2.2
  have tokenFacts (t : Nat) (ht : t∈T) :
      t<93 ∧ ∀ i∈endsOf t, ∃ j∈S, i=j.val := by
    rcases Finset.mem_union.mp ht with h|h
    · obtain ⟨j,hj,hw⟩ := Finset.mem_biUnion.mp h
      obtain ⟨bd,E⟩ := w_ends hw
      refine ⟨bd,fun i hi => ⟨j,hj,?_⟩⟩
      simpa [E] using hi
    · obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp h
      obtain ⟨bd,E⟩ := e_ends hp
      obtain ⟨h1,h2⟩ := Finset.mem_product.mp (Finset.mem_filter.mp hp).1
      refine ⟨bd,fun i hi => ?_⟩
      simp only [E,List.mem_cons,List.mem_nil_iff,or_false] at hi
      exact hi.elim (fun eq => ⟨p.1,h1,eq⟩) (fun eq => ⟨p.2,h2,eq⟩)
  have compat (i j : Fin 57) (hi : i∈S) (hj : j∈S) :
      ((i.val == j.val) || okPair i.val j.val) = true := by
    rcases lt_trichotomy i j with h|rfl|h
    · have g : okPair i.val j.val=true := pair i hi j hj h
      simp [g]
    · simp
    · have g : okPair i.val j.val=true := (profileOK_symm _ _).mpr (pair j hj i hi h)
      simp [g]
  have upper := tokenClique_bound T (fun t ht => (tokenFacts t ht).1) (by
    intro a ha b hb ne
    apply supportOK_sound ⟨a,(tokenFacts a ha).1⟩ ⟨b,(tokenFacts b hb).1⟩
      (fun e => ne (congrArg Fin.val e))
    apply List.all_eq_true.mpr
    intro i hi
    apply List.all_eq_true.mpr
    intro j hj
    obtain ⟨p,hp,rfl⟩ := (tokenFacts a ha).2 i hi
    obtain ⟨q,hq,rfl⟩ := (tokenFacts b hb).2 j hj
    exact compat p q hp hq)
  have disjW : (↑S : Set (Fin 57)).PairwiseDisjoint wTokens := by
    intro a ha b hb ne
    apply Finset.disjoint_left.mpr
    intro t hx hy
    have eq := (w_ends hx).2.symm.trans (w_ends hy).2
    apply ne
    apply Fin.ext
    simpa using eq
  have disjAll : Disjoint (S.biUnion wTokens) (F.image eToken) := by
    apply Finset.disjoint_left.mpr
    intro t hx hy
    obtain ⟨i,_,hi⟩ := Finset.mem_biUnion.mp hx
    obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp hy
    have eq := (w_ends hi).2.symm.trans (e_ends hp).2
    simp at eq
  have eCard : (F.image eToken).card = F.card := by
    apply Finset.card_image_iff.mpr
    intro p hp q hq ee
    have eq := ((e_ends hp).2.symm.trans (congrArg endsOf ee)).trans (e_ends hq).2
    simp only [List.cons.injEq, and_true] at eq
    exact Prod.ext (Fin.ext eq.1) (Fin.ext eq.2)
  have tCard : T.card = (∑ i∈S, ((profileContacts i).card-2)) + F.card := by
    dsimp only [T]
    rw [Finset.card_union_of_disjoint disjAll,Finset.card_biUnion disjW,eCard]
    simp only [wTokens_card]
  rw [tCard] at upper
  exact upper

