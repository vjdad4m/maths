theorem outerRows (m : Fin 32) :
    ∀ a b : Fin 5,m.val∈goodMasks → m.val≠31 → a<b →
      checked (outerSpec m a b) [] (row m.val a.val b.val)=true := by
  fin_cases m <;> decide

variable {V : Type*} {G : SimpleGraph V}

theorem private_mask_necessary (m : Fin 32) (f : Fin 10→V)
    (fi : Function.Injective f)
    (fit : ∀ a b : Fin 10,G.Adj (f a) (f b)↔firstEdge m.val a.val b.val=true)
    (h7 : ¬∃ p : Fin 7→V,InducedPath G p) : m.val∈goodMasks := by
  apply Classical.byContradiction
  intro no
  obtain ⟨i,ed⟩ := badMaskPath m no
  apply h7
  refine ⟨f ∘ reject m.val,fi.comp (fun a b h=>i a b h),?_⟩
  intro a b ab
  rw [Function.comp_apply,Function.comp_apply,fit,ed a b ab,decide_eq_true_eq]

theorem outer_row_impossible (m : Fin 32) (a b : Fin 5)
    (good : m.val∈goodMasks) (nonfull : m.val≠31) (ab : a<b)
    (h4 : FourCycleFree G) (h9 : ¬∃ p : Fin 9→V,InducedPath G p)
    (f : Fin 15→V) (fi : Function.Injective f) (fit : Fit G f (outerSpec m a b)) : False :=
  checked_sound h4 h9 fi _ fit _ [] (by intro x h; cases h) (outerRows m a b good nonfull ab)

#print axioms private_mask_necessary
#print axioms outer_row_impossible
