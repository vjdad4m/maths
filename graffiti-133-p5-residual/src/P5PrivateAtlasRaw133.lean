def CycleEdge (a b : Nat) : Bool := decide ((a+1)%5=b ∨ (b+1)%5=a)
def firstEdge (mask a b : Nat) : Bool :=
  let x := min a b
  let y := max a b
  if y<5 then CycleEdge x y
  else if x<5 then decide (y=x+5)
  else (decide ((x-5+2)%5=y-5) && mask.testBit (x-5)) ||
    (decide ((y-5+2)%5=x-5) && mask.testBit (y-5))

def outerSpec (mask : Fin 32) (a b : Fin 5) (u v : Fin 15) : Option Bool :=
  let x := min u.val v.val
  let y := max u.val v.val
  if y<10 then some (firstEdge mask.val x y)
  else if x<10 then some (decide (x=y-5))
  else if x=a.val+10 ∧ y=b.val+10 then some true else none

def goodMasks : List Nat := [0,1,2,4,5,8,9,10,11,13,16,18,20,21,22,26,31]

def p7Bits (m : Fin 32) (f : Fin 7→Fin 10) : Prop :=
  (∀ a b, f a=f b→a=b) ∧
  (∀ a b : Fin 7,a<b → firstEdge m.val (f a).val (f b).val=decide (a.val+1=b.val))

instance (m : Fin 32) (f : Fin 7→Fin 10) : Decidable (p7Bits m f) := by unfold p7Bits; infer_instance

