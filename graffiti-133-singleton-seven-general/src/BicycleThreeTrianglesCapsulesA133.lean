def firstCheck (c : Nat) : Bool :=
  if stepLegal rows d2 [0] c then
    let w := (data.getD 0 []).getD c 0
    if w<1024 then verify rows d2 data (n-2) w [0,c]
    else pathCheck rows [0,c] (w-1024)
  else true

