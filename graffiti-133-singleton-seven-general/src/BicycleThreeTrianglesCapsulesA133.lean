theorem checked : verify rows d2 data (n-1) 0 [0]=true := by
  change (List.range 7).all firstCheck=true
  apply List.all_eq_true.mpr
  intro i hi
  have lt := List.mem_range.mp hi
  rcases (show i=0 ∨ i=1 ∨ i=2 ∨ i=3 ∨ i=4 ∨ i=5 ∨ i=6 by omega) with rfl|rfl|rfl|rfl|rfl|rfl|rfl
  · exact first0
  · exact first1
  · exact first2
  · exact first3
  · exact first4
  · exact first5
  · exact first6

theorem two_checked : ∀ i j : Fin n, bit d2 i.val j.val=true →
    ∃ k : Fin n, bit rows i.val k.val=true ∧ bit rows j.val k.val=true := by decide

theorem canonical_checked :
    (∀ i j : Fin n, relabel labels (by decide : 1≤n) i =
      relabel labels (by decide) j → i=j) ∧
    (∀ i j : Fin n, bit rows i.val j.val =
      bit canonicalRows (relabel labels (by decide : 1≤n) i).val
        (relabel labels (by decide : 1≤n) j).val) := by decide

theorem extension {V : Type*} [Fintype V] {G : SimpleGraph V} (H : Hole G 7)
    (h4 : FourCycleFree G) (f : Fin n→V) (fi : Function.Injective f)
    (outer : ∀ i, Outside H.c (f i)) (site : Fin n→Fin 7)
    (attach : ∀ i j, G.Adj (f i) (H.c j) ↔ site i=j)
    (edges : ∀ i j, G.Adj (f i) (f j) ↔ bit canonicalRows i.val j.val=true) :
    ∃ p : Fin 9→V, InducedPath G p :=
  hole_canonical_shape_has_nine (by decide) h4 H f fi outer site attach (bit canonicalRows)
    edges labels (fun i j e=>canonical_checked.1 i j e) canonical_checked.2 two_checked checked

