
private theorem one_pin_omission_component_at_most_seven
    (conn : ∀ S : Finset V,S.card<2 → (G.induce ((↑S : Set V)ᶜ)).Connected)
    (degree : ∀ u v : V,u≠v → 4≤G.degree u ∨ 4≤G.degree v)
    {a b : V} {p : G.Walk a b} (hp : IsLongest p)
    (lower : 2≤((univ : Finset V)\p.support.toFinset).card)
    (upper : ((univ : Finset V)\p.support.toFinset).card≤7)
    (few : ∀ x∉p.support,(Pins p x).card≤1) :
    ∃ H : OmittedComponent p, ∀ x∉p.support,x∈H.vertices := by
  classical
  let O := (univ : Finset V)\p.support.toFinset
  have oc : 2≤O.card ∧ O.card≤7 := ⟨lower,upper⟩
  have out {z : V} : z∈O ↔ z∉p.support := by simp [O]
  obtain ⟨r,hr,s,hs,ne⟩ := one_lt_card.mp (show 1<O.card by omega)
  obtain ⟨x,xO,xh⟩ : ∃ x,x∈O ∧ 4≤G.degree x := by
    rcases degree r s ne with dh|dh
    · exact ⟨r,hr,dh⟩
    · exact ⟨s,hs,dh⟩
  have xo := out.mp xO
  obtain ⟨T,xT,Tne,Toff,Tclosed,Tjoined⟩ := exists_omitted_component xo
  let H : OmittedComponent p := ⟨T,Tne,Toff,Tclosed,Tjoined⟩
  have HT : H.vertices⊆O := fun _ h => out.mpr (H.off _ h)
  have nx : G.neighborFinset x ⊆ PinVertices p x ∪ H.vertices.erase x := by
    intro z zn
    have xz := (mem_neighborFinset G x z).mp zn
    by_cases zp : z∈p.support
    · obtain ⟨i,hi,e⟩ := pin_of_neighbor_mem hp xo zp xz
      exact mem_union.mpr (.inl (mem_image.mpr ⟨i,hi,e⟩))
    · have zT : z∈H.vertices := Classical.byContradiction (fun n => zp (H.closed x xT z n xz))
      exact mem_union.mpr (.inr (mem_erase.mpr ⟨xz.ne.symm,zT⟩))
  have large : 4≤H.vertices.card := by
    have n := card_le_card nx
    have bound := card_union_le (PinVertices p x) (H.vertices.erase x)
    rw [card_erase_of_mem (show x∈H.vertices from xT),card_pinVertices hp] at bound
    rw [card_neighborFinset_eq_degree] at n
    have f := few x xo
    have hpos := card_pos.mpr H.nonempty
    omega
  let R := O\H.vertices
  have cR : R.card≤3 := by
    have hs := card_sdiff_add_card_eq_card HT
    change R.card+H.vertices.card=O.card at hs
    omega
  have rlow {z : V} (zr : z∈R) : ¬4≤G.degree z := by
    obtain ⟨zO,zH⟩ := mem_sdiff.mp zr
    have zo := out.mp zO
    have sub : G.neighborFinset z ⊆ PinVertices p z ∪ R.erase z := by
      intro y h
      have zy := (mem_neighborFinset G z y).mp h
      by_cases yp : y∈p.support
      · obtain ⟨i,hi,eq⟩ := pin_of_neighbor_mem hp zo yp zy
        exact mem_union.mpr (.inl (mem_image.mpr ⟨i,hi,eq⟩))
      · have yH : y∉H.vertices := fun yy => zo (H.closed y yy z zH zy.symm)
        exact mem_union.mpr (.inr (mem_erase.mpr ⟨zy.ne.symm,mem_sdiff.mpr ⟨out.mpr yp,yH⟩⟩))
    have low := card_le_card sub
    have bound := card_union_le (PinVertices p z) (R.erase z)
    rw [card_neighborFinset_eq_degree] at low
    rw [card_erase_of_mem zr,card_pinVertices hp] at bound
    have ans := few z zo
    have pos := card_pos.mpr ⟨z,zr⟩
    omega
  have only_R (y z : V) (yr : y∈R) (zr : z∈R) : y=z := by
    by_contra ne
    exact (degree y z ne).elim (rlow yr) (rlow zr)
  refine ⟨H,?_⟩
  intro y yo
  by_contra yT
  have yr : y∈R := mem_sdiff.mpr ⟨out.mpr yo,yT⟩
  have sub : G.neighborFinset y ⊆ PinVertices p y := by
    intro z h
    have yz := (mem_neighborFinset G y z).mp h
    by_cases zp : z∈p.support
    · obtain ⟨i,hi,eq⟩ := pin_of_neighbor_mem hp yo zp yz
      exact mem_image.mpr ⟨i,hi,eq⟩
    · have zT : z∉H.vertices := fun zz => yo (H.closed z zz y yT yz.symm)
      exact (yz.ne (only_R y z yr (mem_sdiff.mpr ⟨out.mpr zp,zT⟩))).elim
  have low := card_le_card sub
  rw [card_neighborFinset_eq_degree,card_pinVertices hp] at low
  have at_least : 3≤Fintype.card V := by
    have n := card_le_card (subset_univ H.vertices)
    rw [card_univ] at n
    omega
  have min2 := min_two_from_cut conn at_least y
  have max1 := few y yo
  omega


private theorem two_active_of_left_covers
    (hc : G.Connected) (even : ∀ v,(EvenFrom G v).card≤5)
    (conn : ∀ S : Finset V,S.card<2 → (G.induce ((↑S : Set V)ᶜ)).Connected)
    (degree : ∀ u v : V,u≠v → 4≤G.degree u ∨ 4≤G.degree v)
    {a b : V} {p : G.Walk a b} (hp : EdgeOptimal p) (ah : 4≤G.degree a) (bh : 4≤G.degree b)
    (H : OmittedComponent p)
    (few : ∀ x∉p.support,(Pins p x).card≤1)
    (left : ∀ x∉p.support, ∀ i∈Pins p x,G.Adj a (p.getVert i)) :
    ∃ x y : V, ∃ i j : ℕ, x∉p.support ∧ y∉p.support ∧ x≠y ∧ i≠j ∧
      i∈Pins p x ∧ j∈Pins p y ∧ (i+3≤j ∨ j+3≤i) ∧
      (∀ z∉p.support, (Pins p z).Nonempty → z=x ∨ z=y) := by
  classical
  let O := (univ : Finset V)\p.support.toFinset
  have out {z : V} : z∈O ↔ z∉p.support := by simp [O]
  have Hpins := componentPins_card hp.1 H 2 conn
  obtain ⟨u,hu,v,hv,uv⟩ := one_lt_card.mp (show 1<(componentPins H).card by omega)
  obtain ⟨up,x,xH,xu⟩ := mem_filter.mp hu
  obtain ⟨vp,y,yH,yv⟩ := mem_filter.mp hv
  have xo := H.off x xH
  have yo := H.off y yH
  obtain ⟨i,hi,iu⟩ := pin_of_neighbor_mem hp.1 xo (List.mem_toFinset.mp up) xu
  obtain ⟨j,hj,jv⟩ := pin_of_neighbor_mem hp.1 yo (List.mem_toFinset.mp vp) yv
  have ne : i≠j := fun e => uv (iu.symm.trans ((congrArg p.getVert e).trans jv))
  have xy : x≠y := by
    intro e
    subst y
    have lo := one_lt_card.mpr ⟨i,hi,j,hj,ne⟩
    have up := few x xo
    omega
  have gap : i+3≤j ∨ j+3≤i := by
    rcases lt_or_gt_of_ne ne with ij|ij
    · exact .inl (component_pins_spaced_four hc even conn degree hp ah bh H xH yH hi hj ij)
    · exact .inr (component_pins_spaced_four hc even conn degree hp ah bh H yH xH hj hi ij)
  have il := (pin_data hi).1
  have jl := (pin_data hj).1
  let U := O.filter (fun z => (Pins p z).Nonempty)
  have d2 (z : V) (zo : z∉p.support) (za : (Pins p z).Nonempty) : z∈DistanceTwo G a := by
    obtain ⟨k,hk⟩ := za
    exact mem_distanceTwo.mpr (dist_two hc (fun e => zo (e ▸ p.start_mem_support))
      (fun h => (no_endpoints hp.1 zo).1 h.symm) (left z zo k hk) (pin_data hk).2.symm)
  have successor {z : V} (zo : z∉p.support) {k : ℕ} (hk : k∈Pins p z) :
      p.getVert (k+1)∈DistanceTwo G a := by
    have kk := (pin_data hk).1
    apply mem_distanceTwo.mpr
    exact dist_two hc (fun e => by
      have Q := hp.1.1.getVert_injOn (Nat.zero_le _) (show k+1≤p.length by omega) (p.getVert_zero.trans e)
      omega) (start_not_adj_pin_successor hp.1 zo hk)
      (left z zo k hk) (p.adj_getVert_succ kk)
  have sub : insert (p.getVert (i+1)) (insert (p.getVert (j+1)) U) ⊆ DistanceTwo G a := by
    intro z hz
    rcases mem_insert.mp hz with hh|hh
    · exact hh.symm ▸ successor xo hi
    rcases mem_insert.mp hh with hh|hh
    · exact hh.symm ▸ successor yo hj
    · exact d2 z (out.mp (mem_filter.mp hh).1) (mem_filter.mp hh).2
  have not_U {k : ℕ} : p.getVert k∉U := fun h =>
    (out.mp (mem_filter.mp h).1) (p.getVert_mem_support _)
  have extra : p.getVert (i+1)∉insert (p.getVert (j+1)) U := by
    intro h
    rcases mem_insert.mp h with h|h
    · have ee := hp.1.1.getVert_injOn (show i+1≤p.length by omega) (show j+1≤p.length by omega) h
      omega
    · exact not_U h
  have cd := card_le_card sub
  rw [card_insert_of_not_mem extra,card_insert_of_not_mem (not_U (k:=j+1))] at cd
  have cap := distanceTwo_le_of_even 4 a (even a)
  have xu' : x∈U := mem_filter.mpr ⟨out.mpr xo,⟨i,hi⟩⟩
  have yu' : y∈U := mem_filter.mpr ⟨out.mpr yo,⟨j,hj⟩⟩
  have eq : U=({x,y}:Finset V) := (eq_of_subset_of_card_le
    (show ({x,y}:Finset V)⊆U from fun v hv =>
      (mem_insert.mp hv).elim (fun e => e.symm ▸ xu') (fun e => (mem_singleton.mp e).symm ▸ yu'))
    (by rw [card_insert_of_not_mem (by simpa using xy),card_singleton]; omega)).symm
  refine ⟨x,y,i,j,xo,yo,xy,ne,hi,hj,gap,?_⟩
  intro z zo za
  have inU : z∈U := mem_filter.mpr ⟨out.mpr zo,za⟩
  simpa [eq] using inU


private theorem length_nine_one_end_hits_all_ports
    (hc : G.Connected) (even : ∀ v,(EvenFrom G v).card≤5)
    (conn : ∀ S : Finset V,S.card<2 → (G.induce ((↑S : Set V)ᶜ)).Connected)
    (degree : ∀ u v : V,u≠v → 4≤G.degree u ∨ 4≤G.degree v)
    {a b : V} {p : G.Walk a b} (hp : EdgeOptimal p) (ah : 4≤G.degree a) (bh : 4≤G.degree b)
    (len : p.length=9) (H : OmittedComponent p) (whole : ∀ z∉p.support,z∈H.vertices) :
    (∀ x∉p.support,∀ i∈Pins p x,G.Adj a (p.getVert i)) ∨
    (∀ x∉p.support,∀ i∈Pins p x,G.Adj b (p.getVert i)) := by
  classical
  obtain ⟨x,xH⟩ := H.nonempty
  have xo := H.off x xH
  have low := componentPins_card hp.1 H 2 conn
  obtain ⟨y,ym⟩ := card_pos.mp (show 0<(componentPins H).card by omega)
  obtain ⟨yp,z,zH,zy⟩ := mem_filter.mp ym
  have zo := H.off z zH
  obtain ⟨i,hi,_⟩ := pin_of_neighbor_mem hp.1 zo (List.mem_toFinset.mp yp) zy
  have left_all_or_right_all :
      (∀ x∉p.support,∀ i∈Pins p x,G.Adj a (p.getVert i)) ∨
      (∀ x∉p.support,∀ i∈Pins p x,G.Adj b (p.getVert i)) := by
    by_contra! no
    obtain ⟨⟨u,uo,k,ku,ak⟩,⟨v,vo,l,lv,bl⟩⟩ := no
    have kp := pin_pos hp.1 uo ku
    have kr := (pin_data ku).1
    have lr := (pin_data lv).1
    have m1 : k-1∉LeftMarks p∪RightMarks p := by
      intro hm
      rcases mem_union.mp hm with h|h
      · exact ak (by
          have g := (mem_filter.mp h).2
          rwa [show k-1+1=k by omega] at g)
      · exact end_not_adj_pin_predecessor hp.1 uo ku (mem_filter.mp h).2
    have m2 : l∉LeftMarks p∪RightMarks p := by
      intro hm
      exact (mem_union.mp hm).elim
        (fun h => start_not_adj_pin_successor hp.1 vo lv (mem_filter.mp h).2)
        (fun h => bl (mem_filter.mp h).2)
    have q := at_most_one_hole hp.1 zo (p.getVert_mem_support i) (pin_data hi).2 ah bh
      len.le (show k-1<p.length by omega) lr m1 m2
    have gap := component_pins_spaced_four hc even conn degree hp ah bh H (whole _ vo) (whole _ uo) lv ku (by omega)
    omega
  exact left_all_or_right_all


private theorem length_nine_single_pin_left_contradiction
    (hc : G.Connected) (even : ∀ v,(EvenFrom G v).card≤5)
    (conn : ∀ S : Finset V,S.card<2 → (G.induce ((↑S : Set V)ᶜ)).Connected)
    (degree : ∀ u v : V,u≠v → 4≤G.degree u ∨ 4≤G.degree v)
    {a b : V} {p : G.Walk a b} (hp : EdgeOptimal p) (ah : 4≤G.degree a) (bh : 4≤G.degree b)
    (len : p.length=9) (H : OmittedComponent p)
    (few : ∀ x∉p.support,(Pins p x).card≤1)
    (left : ∀ x∉p.support,∀ i∈Pins p x,G.Adj a (p.getVert i)) : False := by
  classical
  obtain ⟨x,y,i,j,xo,yo,xy,ij,hi,hj,gap,_⟩ :=
    two_active_of_left_covers hc even conn degree hp ah bh H few left
  obtain ⟨x,y,i,j,xo,yo,xy,hi,hj,gap⟩ : ∃ (x y : V) (i j : ℕ),
      x∉p.support ∧ y∉p.support ∧ x≠y ∧ i∈Pins p x ∧ j∈Pins p y ∧ i+3≤j := by
    rcases gap with g|g
    · exact ⟨x,y,i,j,xo,yo,xy,hi,hj,g⟩
    · exact ⟨y,x,j,i,yo,xo,xy.symm,hj,hi,g⟩
  have il := (pin_data hi).1
  have jl := (pin_data hj).1
  have ip := pin_pos hp.1 xo hi
  have jp := pin_pos hp.1 yo hj
  have ai := left x xo i hi
  have aj := left y yo j hj
  have vert_ne {s t : ℕ} (sl : s≤p.length) (tl : t≤p.length) (ne : s≠t) :
      p.getVert s≠p.getVert t := fun e => ne (hp.1.1.getVert_injOn sl tl e)
  have di {k : ℕ} {z : V} (zo : z∉p.support) (hk : k∈Pins p z) :
      z∈DistanceTwo G a := mem_distanceTwo.mpr (dist_two hc
    (fun e => zo (e ▸ p.start_mem_support)) (fun e => (no_endpoints hp.1 zo).1 e.symm)
      (left z zo k hk) (pin_data hk).2.symm)
  have plus {k : ℕ} {z : V} (zo : z∉p.support) (hk : k∈Pins p z) :
      p.getVert (k+1)∈DistanceTwo G a := by
    have kl := (pin_data hk).1
    exact mem_distanceTwo.mpr (dist_two hc (fun h => vert_ne (s:=0) (by omega) (by omega)
      (by omega) (p.getVert_zero.trans h)) (start_not_adj_pin_successor hp.1 zo hk)
      (left z zo k hk) (p.adj_getVert_succ kl))
  let S : Finset V := {p.getVert (i+1),p.getVert (j+1),x,y}
  have sub : S⊆DistanceTwo G a := insert_subset (plus xo hi)
    (insert_subset (plus yo hj) (insert_subset (di xo hi) (singleton_subset_iff.mpr (di yo hj))))
  have sxy {k : ℕ} : p.getVert k≠x ∧ p.getVert k≠y :=
    ⟨fun e => xo (e ▸ p.getVert_mem_support k),fun e => yo (e ▸ p.getVert_mem_support k)⟩
  have ij : p.getVert (i+1)≠p.getVert (j+1) := vert_ne (by omega) (by omega) (by omega)
  have sc : S.card=4 := by
    rw [show S=({p.getVert (i+1),p.getVert (j+1),x,y}:Finset V) from rfl,
      card_insert_of_not_mem (by simp [ij,sxy.1,sxy.2]),
      card_insert_of_not_mem (by simp [sxy.1,sxy.2]),
      card_insert_of_not_mem (by simp [xy]),card_singleton]
  have cap := distanceTwo_le_of_even 4 a (even a)
  have eq : DistanceTwo G a=S := (eq_of_subset_of_card_le sub (by omega)).symm
  have step {k : ℕ} (kp : 0<k) (kl : k<p.length) (n1 : k≠i+1) (n2 : k≠j+1)
      (ch : G.Adj a (p.getVert (k+1))) : G.Adj a (p.getVert k) := by
    by_contra ban
    have dk : p.getVert k∈DistanceTwo G a := mem_distanceTwo.mpr
      (dist_two hc (fun h => vert_ne (s:=0) (Nat.zero_le _) kl.le (by omega)
        (p.getVert_zero.trans h)) ban ch (p.adj_getVert_succ kl).symm)
    rw [eq] at dk
    simp only [S,mem_insert,mem_singleton,sxy.1,sxy.2,or_false] at dk
    exact dk.elim (fun e => vert_ne kl.le (by omega) n1 e)
      (fun e => vert_ne kl.le (by omega) n2 e)
  have sweep (lo hi : ℕ) (lp : 1≤lo) (hl : hi<p.length) (ch : G.Adj a (p.getVert hi))
      (safe : ∀ q,lo≤q → q<hi → q≠i+1 ∧ q≠j+1) :
      ∀ k,lo≤k → k≤hi → G.Adj a (p.getVert k) := by
    have iter : ∀ n, n≤hi-lo → G.Adj a (p.getVert (hi-n)) := by
      intro n
      induction n with
      | zero => intro _; simpa using ch
      | succ n ih =>
        intro hn
        have hl' : lo≤hi-n.succ := by omega
        have ht : hi-n.succ<hi := by omega
        have next := ih (by omega)
        rw [show hi-n=hi-n.succ+1 by omega] at next
        exact step (by omega) (by omega) (safe _ hl' ht).1 (safe _ hl' ht).2 next
    intro k kl kh
    have a := iter (hi-k) (by omega)
    rwa [show hi-(hi-k)=k by omega] at a
  have first := sweep 1 i (by decide) il ai (by intro k kl kh; omega)
  have second := sweep (i+2) j (by omega) jl aj (by intro k kl kh; omega)
  let U := range i
  let W := (range (j-(i+1))).image (fun k=>i+1+k)
  have wu : Disjoint U W := disjoint_left.mpr (by
    intro k ku kw
    obtain ⟨q,qm,eq⟩ := mem_image.mp kw
    have kl := mem_range.mp ku
    omega)
  have Wc : W.card=j-(i+1) := by
    change ((range (j-(i+1))).image _).card=j-(i+1)
    rw [card_image_of_injective _ (show Function.Injective (fun k : ℕ => i+1+k) from by
      intro k l eq
      change i+1+k=i+1+l at eq
      omega),
      card_range]
  have lsub : U∪W ⊆ LeftMarks p := by
    intro k hk
    rcases mem_union.mp hk with hu|hw
    · have k_lt : k<i := mem_range.mp hu
      exact mem_filter.mpr ⟨mem_range.mpr (by omega),first (k+1) (by omega) (by omega)⟩
    · obtain ⟨q,qm,rfl⟩ := mem_image.mp hw
      have ql := mem_range.mp qm
      exact mem_filter.mpr ⟨mem_range.mpr (by omega),second (i+1+q+1) (by omega) (by omega)⟩
  have left_count := card_le_card lsub
  rw [card_union_of_disjoint wu,show U.card=i from card_range i,Wc,card_leftMarks hp.1] at left_count
  have bm := mark_length hp.1 xo (p.getVert_mem_support i) (pin_data hi).2 ∅ (empty_subset _) (by simp)
  have j6 : j≤6 := by simp only [card_empty,Nat.add_zero] at bm; omega
  have t9 : p.getVert 9=b := by simpa only [len] using p.getVert_length
  have bno : b∉DistanceTwo G a := by
    rw [eq]
    intro h
    have xb : b≠x := fun e => xo (e ▸ p.end_mem_support)
    have yb : b≠y := fun e => yo (e ▸ p.end_mem_support)
    simp only [S,mem_insert,mem_singleton,xb,yb,or_false] at h
    exact h.elim (fun q => vert_ne (s:=9) (by omega) (by omega) (by omega) (t9.trans q))
      (fun q => vert_ne (s:=9) (by omega) (by omega) (by omega) (t9.trans q))
  have ab : ¬G.Adj a b := by
    intro e
    have e' : G.Adj a (p.getVert (8+1)) := t9.symm ▸ e
    have last : G.Adj b (p.getVert 8) := by
      simpa only [t9] using (p.adj_getVert_succ (i:=8) (by omega)).symm
    exact not_adj_both_end_marks hp.1 xo (p.getVert_mem_support i) (pin_data hi).2
      (show 8<p.length by omega) e' last
  have ab_ne : a≠b := fun e =>
    vert_ne (s:=0) (t:=9) (by omega) (by omega) (by decide)
      (p.getVert_zero.trans (e.trans t9.symm))
  have missing {k : ℕ} {z : V} (zo : z∉p.support) (hk : k∈Pins p z) :
      k∉LeftMarks p∪RightMarks p := by
    intro h
    rcases mem_union.mp h with le|ri
    · exact start_not_adj_pin_successor hp.1 zo hk (mem_filter.mp le).2
    · exact bno (mem_distanceTwo.mpr (dist_two hc ab_ne ab
        (left z zo k hk) (mem_filter.mp ri).2.symm))
  have ne := at_most_one_hole hp.1 xo (p.getVert_mem_support i) (pin_data hi).2 ah bh len.le
    il jl (missing xo hi) (missing yo hj)
  omega


private theorem length_nine_five_off_single_pin
    (hc : G.Connected) (even : ∀ v,(EvenFrom G v).card≤5)
    (conn : ∀ S : Finset V,S.card<2 → (G.induce ((↑S : Set V)ᶜ)).Connected)
    (degree : ∀ u v : V,u≠v → 4≤G.degree u ∨ 4≤G.degree v)
    {a b : V} {p : G.Walk a b} (hp : EdgeOptimal p) (ah : 4≤G.degree a) (bh : 4≤G.degree b)
    (len : p.length=9) (off : ((univ : Finset V)\p.support.toFinset).card=5)
    (few : ∀ x∉p.support,(Pins p x).card≤1) : False := by
  classical
  obtain ⟨H,whole⟩ := one_pin_omission_component_at_most_seven conn degree hp.1
    (by omega) (by omega) few
  rcases length_nine_one_end_hits_all_ports hc even conn degree hp ah bh len H whole with l|r
  · exact length_nine_single_pin_left_contradiction hc even conn degree hp ah bh len H few l
  have ep : EdgeOptimal p.reverse := same_support_optimal hp (reverse_long hp.1) (by intro z; simp)
  have lr : p.reverse.length=9 := by simpa using len
  have fewer (z : V) (zo : z∉p.reverse.support) : (Pins p.reverse z).card≤1 := by
    have zp : z∉p.support := by simpa using zo
    have d := omittedDegree_eq hp.1 zp
    have dr := omittedDegree_eq ep.1 zo
    have agree : omittedNeighbors p.reverse z=omittedNeighbors p z := by simp [omittedNeighbors,support_reverse]
    rw [agree] at dr
    have f := few z zp
    omega
  have left (z : V) (zo : z∉p.reverse.support) (i : ℕ) (hi : i∈Pins p.reverse z) :
      G.Adj b (p.reverse.getVert i) := by
    have zp : z∉p.support := by simpa using zo
    have vP : p.reverse.getVert i∈p.support := by
      simpa [support_reverse] using p.reverse.getVert_mem_support i
    obtain ⟨j,hj,e⟩ := pin_of_neighbor_mem hp.1 zp vP (pin_data hi).2
    rw [←e]
    exact r z zp j hj
  let H' : OmittedComponent p.reverse :=
    ⟨H.vertices,H.nonempty,fun z zm => by simpa using H.off z zm,
      fun z zm w wn adj => by simpa using H.closed z zm w wn adj,H.joined⟩
  exact length_nine_single_pin_left_contradiction hc even conn degree ep bh ah lr H' fewer left

#print axioms length_nine_five_off_single_pin
