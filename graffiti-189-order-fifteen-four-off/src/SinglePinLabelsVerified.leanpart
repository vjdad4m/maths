
private theorem off_four_order_fifteen
    {a b : V} {p : G.Walk a b} (hp : IsLongest p) (len : p.length=10)
    (off : ((univ : Finset V)\p.support.toFinset).card=4) :
    Fintype.card V=15 := by
  have d := card_sdiff_add_card_eq_card (subset_univ p.support.toFinset)
  rw [card_univ] at d
  have cl : p.support.toFinset.card=11 := by
    rw [List.toFinset_card_of_nodup hp.1.support_nodup,length_support,len]
  omega

private theorem model15_off_four_label_omitted
    {a b x y : V} {p : G.Walk a b} (hp : IsLongest p)
    (len : p.length=10) (off : ((univ : Finset V)\p.support.toFinset).card=4)
    (degree : ∀ u v : V,u≠v → 4≤G.degree u ∨ 4≤G.degree v)
    (xo : x∉p.support) (yo : y∉p.support) {i j : ℕ}
    (hi : i∈Pins p x) (hj : j∈Pins p y) (ij : i+3≤j)
    (few : ∀ z∉p.support,(Pins p z).card≤1)
    (ports : ∀ z∉p.support,Pins p z⊆({i,j}:Finset ℕ)) :
    ∃ (c d : ℕ) (φ : Fin 15→V),
      (c,d)∈([(1,2),(2,1),(1,3),(2,2),(3,1)]:List (ℕ×ℕ)) ∧
      Function.Injective φ ∧ (∀ k : Fin 15,k.val≤10 → φ k=p.getVert k.val) ∧
      (∀ k : Fin 15,11≤k.val → φ k∉p.support) ∧
      (∀ k : Fin 15,11≤k.val → k.val<11+c → i∈Pins p (φ k)) ∧
      (∀ k : Fin 15,11+c≤k.val → k.val<11+c+d → j∈Pins p (φ k)) := by
  classical
  let O := (univ : Finset V)\p.support.toFinset
  let A := O.filter (fun z => i∈Pins p z)
  let B := O.filter (fun z => j∈Pins p z)
  let C := O\(A∪B)
  have out {z : V} : z∈O ↔ z∉p.support := by simp [O]
  have oc : O.card=4 := off
  have disAB : Disjoint A B := by
    apply disjoint_left.mpr
    intro z a b
    have f := few z (out.mp (mem_filter.mp a).1)
    have q := one_lt_card.mpr ⟨i,(mem_filter.mp a).2,j,(mem_filter.mp b).2,by omega⟩
    omega
  have cd : A.card+B.card+C.card=4 := by
    have h := card_sdiff_add_card_eq_card
      (show A∪B⊆O from union_subset (filter_subset _ _) (filter_subset _ _))
    rw [card_union_of_disjoint disAB] at h
    change C.card+(A.card+B.card)=O.card at h
    omega
  have posA : 0<A.card := card_pos.mpr ⟨x,mem_filter.mpr ⟨out.mpr xo,hi⟩⟩
  have posB : 0<B.card := card_pos.mpr ⟨y,mem_filter.mpr ⟨out.mpr yo,hj⟩⟩
  have Csmall : C.card≤1 := by
    by_contra n
    obtain ⟨u,um,v,vm,ne⟩ := one_lt_card.mp (Nat.lt_of_not_ge n)
    have clow {z : V} (zc : z∈C) : ¬4≤G.degree z := by
      have zO := (mem_sdiff.mp zc).1
      have zo := out.mp zO
      intro zh
      have d := degree_off_bound hp zo
      rw [off] at d
      obtain ⟨k,km⟩ := card_pos.mp (show 0<(Pins p z).card by omega)
      have ks := ports z zo km
      rcases mem_insert.mp ks with rfl|ks
      · exact (mem_sdiff.mp zc).2 (mem_union.mpr (.inl (mem_filter.mpr ⟨zO,km⟩)))
      · obtain rfl := mem_singleton.mp ks
        exact (mem_sdiff.mp zc).2 (mem_union.mpr (.inr (mem_filter.mpr ⟨zO,km⟩)))
    exact (degree u v ne).elim (clow um) (clow vm)
  let eA : Fin A.card ≃ A := (Fintype.equivFinOfCardEq (by simp)).symm
  let eB : Fin B.card ≃ B := (Fintype.equivFinOfCardEq (by simp)).symm
  let eC : Fin C.card ≃ C := (Fintype.equivFinOfCardEq (by simp)).symm
  let φ : Fin 15→V := fun v =>
    if h : v.val≤10 then p.getVert v.val else
    if k : v.val<11+A.card then (eA ⟨v.val-11,by omega⟩).val else
    if l : v.val<11+A.card+B.card then (eB ⟨v.val-(11+A.card),by omega⟩).val else
      (eC ⟨v.val-(11+A.card+B.card),by have W := v.isLt; omega⟩).val
  have on {v : Fin 15} (vh : v.val≤10) : φ v=p.getVert v.val := by simp [φ,vh]
  have a_label {v : Fin 15} (vl : 11≤v.val) (vu : v.val<11+A.card) :
      φ v=(eA ⟨v.val-11,by omega⟩).val := by
    simp [φ,show ¬v.val≤10 by omega,vu]
  have b_label {v : Fin 15} (vl : 11+A.card≤v.val) (vu : v.val<11+A.card+B.card) :
      φ v=(eB ⟨v.val-(11+A.card),by omega⟩).val := by
    simp [φ,show ¬v.val≤10 by omega,show ¬v.val<11+A.card by omega,vu]
  have c_label {v : Fin 15} (vl : 11+A.card+B.card≤v.val) :
      φ v=(eC ⟨v.val-(11+A.card+B.card),by have W := v.isLt; omega⟩).val := by
    simp [φ,show ¬v.val≤10 by omega,show ¬v.val<11+A.card by omega,show ¬v.val<11+A.card+B.card by omega]
  have a_mem {v : Fin 15} (vl : 11≤v.val) (vu : v.val<11+A.card) : φ v∈A := by
    rw [a_label vl vu]
    exact Subtype.property _
  have b_mem {v : Fin 15} (vl : 11+A.card≤v.val) (vu : v.val<11+A.card+B.card) : φ v∈B := by
    rw [b_label vl vu]
    exact Subtype.property _
  have c_mem {v : Fin 15} (vl : 11+A.card+B.card≤v.val) : φ v∈C := by
    rw [c_label vl]
    exact Subtype.property _
  have offLabel {v : Fin 15} (vl : 11≤v.val) : φ v∉p.support := by
    apply out.mp
    by_cases va : v.val<11+A.card
    · exact (mem_filter.mp (a_mem vl va)).1
    by_cases vb : v.val<11+A.card+B.card
    · exact (mem_filter.mp (b_mem (by omega) vb)).1
    exact (mem_sdiff.mp (c_mem (by omega))).1
  have inj : Function.Injective φ := by
    intro u v uv
    apply Fin.ext
    by_cases up : u.val≤10 <;> by_cases vp : v.val≤10
    · exact hp.1.getVert_injOn (show u.val≤p.length by omega) (show v.val≤p.length by omega)
        ((on up).symm.trans (uv.trans (on vp)))
    · exact False.elim (offLabel (show 11≤v.val by omega)
        (uv ▸ ((on up).symm ▸ p.getVert_mem_support u.val)))
    · exact False.elim (offLabel (show 11≤u.val by omega)
        (uv.symm ▸ ((on vp).symm ▸ p.getVert_mem_support v.val)))
    have ul : 11≤u.val := by omega
    have vl : 11≤v.val := by omega
    by_cases ua : u.val<11+A.card <;> by_cases va : v.val<11+A.card
    · rw [a_label ul ua,a_label vl va] at uv
      have eq := congrArg Fin.val (eA.injective (Subtype.ext uv))
      change u.val-11=v.val-11 at eq
      omega
    · have uA := a_mem ul ua
      by_cases vb : v.val<11+A.card+B.card
      · exact False.elim ((disjoint_left.mp disAB) (uv ▸ uA) (b_mem (by omega) vb))
      · exact False.elim ((mem_sdiff.mp (c_mem (show 11+A.card+B.card≤v.val by omega))).2
          (mem_union.mpr (.inl (uv ▸ uA))))
    · have vA := a_mem vl va
      by_cases ub : u.val<11+A.card+B.card
      · exact False.elim ((disjoint_left.mp disAB) (uv.symm ▸ vA) (b_mem (by omega) ub))
      · exact False.elim ((mem_sdiff.mp (c_mem (show 11+A.card+B.card≤u.val by omega))).2
          (mem_union.mpr (.inl (uv.symm ▸ vA))))
    by_cases ub : u.val<11+A.card+B.card <;> by_cases vb : v.val<11+A.card+B.card
    · rw [b_label (show 11+A.card≤u.val by omega) ub,b_label (show 11+A.card≤v.val by omega) vb] at uv
      have eq := congrArg Fin.val (eB.injective (Subtype.ext uv))
      change u.val-(11+A.card)=v.val-(11+A.card) at eq
      omega
    · have uB := b_mem (show 11+A.card≤u.val by omega) ub
      exact False.elim ((mem_sdiff.mp (c_mem (show 11+A.card+B.card≤v.val by omega))).2
        (mem_union.mpr (.inr (uv ▸ uB))))
    · have vB := b_mem (show 11+A.card≤v.val by omega) vb
      exact False.elim ((mem_sdiff.mp (c_mem (show 11+A.card+B.card≤u.val by omega))).2
        (mem_union.mpr (.inr (uv.symm ▸ vB))))
    · rw [c_label (show 11+A.card+B.card≤u.val by omega),
        c_label (show 11+A.card+B.card≤v.val by omega)] at uv
      have eq := congrArg Fin.val (eC.injective (Subtype.ext uv))
      change u.val-(11+A.card+B.card)=v.val-(11+A.card+B.card) at eq
      omega
  refine ⟨A.card,B.card,φ,?_,inj,(fun _ h => on h),(fun _ h => offLabel h),
    (fun _ ll lu => (mem_filter.mp (a_mem ll lu)).2),
    (fun _ ll lu => (mem_filter.mp (b_mem ll lu)).2)⟩
  simp only [List.mem_cons,List.not_mem_nil,or_false,Prod.mk.injEq]
  omega
#print axioms model15_off_four_label_omitted
