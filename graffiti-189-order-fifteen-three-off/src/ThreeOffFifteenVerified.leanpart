
private theorem length_eleven_two_pin_hits_boundary
    (hc : G.Connected) (even : ∀ v,(EvenFrom G v).card≤5)
    (conn : ∀ S : Finset V,S.card<2 → (G.induce ((↑S : Set V)ᶜ)).Connected)
    (degree : ∀ u v : V,u≠v → 4≤G.degree u ∨ 4≤G.degree v)
    {a b x : V} {p : G.Walk a b} (hp : EdgeOptimal p)
    (ah : 4≤G.degree a) (bh : 4≤G.degree b) (len : p.length=11)
    (xo : x∉p.support) {i j : ℕ} (hi : i∈Pins p x) (hj : j∈Pins p x) (gap : i+3≤j) :
    (i=1 ∨ j=10) ∧
    (j≠10 → i∉LeftMarks p∪RightMarks p ∧ j∉LeftMarks p∪RightMarks p) := by
  classical
  have cap := fun v => distanceTwo_le_of_even 4 v (even v)
  have f := (at_most_two_pins_one_slack hc 2 (by decide) cap conn degree hp xo).1
  have en := pin_two_contacts_end hp.1 hc xo f (cap x) hi hj gap
  have il := (pin_data hi).1
  have jl := (pin_data hj).1
  have ip := pin_pos hp.1 xo hi
  have left (no : i≠1) : i-1∉LeftMarks p∪RightMarks p ∧ j-1∉LeftMarks p∪RightMarks p :=
    ⟨(mark_holes_of_pin_and_missing_endpoint hp.1 xo hi).1 (fun h => no (en.1 i hi h)),
     (mark_holes_of_pin_and_missing_endpoint hp.1 xo hj).1 (fun h => no (en.1 j hj h))⟩
  have right (no : j≠10) : i∉LeftMarks p∪RightMarks p ∧ j∉LeftMarks p∪RightMarks p :=
    ⟨(mark_holes_of_pin_and_missing_endpoint hp.1 xo hi).2
       (fun h => no (by have e := en.2 i hi h; omega)),
     (mark_holes_of_pin_and_missing_endpoint hp.1 xo hj).2
       (fun h => no (by have e := en.2 j hj h; omega))⟩
  refine ⟨?_,right⟩
  by_contra! no
  let S : Finset ℕ := {i-1,i,j-1,j}
  have sub : S⊆range p.length := by
    intro k km
    have h : k=i-1 ∨ k=i ∨ k=j-1 ∨ k=j := by simpa [S] using km
    rcases h with h|h|h|h <;> exact mem_range.mpr (by omega)
  have size : S.card=4 := by
    have nh1 : i-1∉({i,j-1,j}:Finset ℕ) := by simp only [mem_insert,mem_singleton]; omega
    have nh2 : i∉({j-1,j}:Finset ℕ) := by simp only [mem_insert,mem_singleton]; omega
    have nh3 : j-1∉({j}:Finset ℕ) := by simp only [mem_singleton]; omega
    rw [show S={i-1,i,j-1,j} from rfl,card_insert_of_not_mem nh1,card_insert_of_not_mem nh2,
      card_insert_of_not_mem nh3,card_singleton]
  have nd : Disjoint (LeftMarks p∪RightMarks p) S := by
    apply disjoint_left.mpr
    intro k km ks
    have h : k=i-1 ∨ k=i ∨ k=j-1 ∨ k=j := by simpa [S] using ks
    rcases h with rfl|rfl|rfl|rfl
    · exact (left no.1).1 km
    · exact (right no.2).1 km
    · exact (left no.1).2 km
    · exact (right no.2).2 km
  have bd := mark_length hp.1 xo (p.getVert_mem_support i) (pin_data hi).2 S sub nd
  omega
#print axioms length_eleven_two_pin_hits_boundary

private theorem length_eleven_left_block_of_small_path_d2
    (hc : G.Connected)
    {a b x : V} {p : G.Walk a b} (hp : IsLongest p)
    (ah : 4≤G.degree a) (bh : 4≤G.degree b) (len : p.length=11)
    (xo : x∉p.support) (h1 : 1∈Pins p x)
    (small : ((DistanceTwo G a).filter (· ∈ p.support)).card≤2) :
    ∃ t : ℕ, 5≤t ∧ t≤9 ∧
      (∀ k : ℕ,3≤k → k≤t → G.Adj a (p.getVert k)) ∧
      (∀ k : ℕ,k≤p.length → G.Adj a (p.getVert k) → k=1 ∨ (3≤k ∧ k≤t)) ∧
      ¬G.Adj a b ∧ b∉DistanceTwo G a := by
  classical
  let D := (DistanceTwo G a).filter (· ∈ p.support)
  change D.card≤2 at small
  have vr {i j : ℕ} (ir : i≤p.length) (jr : j≤p.length) (ne : i≠j) :
      p.getVert i≠p.getVert j := fun e => ne (hp.1.getVert_injOn ir jr e)
  have na : ¬G.Adj a b := by
    intro e
    have ar : 10<p.length := by omega
    have ten : p.getVert 11=b := by simpa only [len] using p.getVert_length
    have ea : G.Adj a (p.getVert (10+1)) := by simpa only [ten] using e
    have eb : G.Adj b (p.getVert 10) := by simpa only [ten] using (p.adj_getVert_succ ar).symm
    exact not_adj_both_end_marks hp xo (p.getVert_mem_support 1) (pin_data h1).2 ar ea eb
  have aA : ¬G.Adj a (p.getVert 0) := by simp
  have first : G.Adj a (p.getVert 1) := by simpa using p.adj_getVert_succ (i:=0) (by omega)
  have nTwo : ¬G.Adj a (p.getVert 2) := start_not_adj_pin_successor hp xo h1
  have mkD {i : ℕ} (ip : 0<i) (ir : i≤p.length)
      (no : ¬G.Adj a (p.getVert i)) {j : ℕ} (adj : G.Adj a (p.getVert j))
      (edge : G.Adj (p.getVert j) (p.getVert i)) : p.getVert i∈D :=
    mem_filter.mpr ⟨mem_distanceTwo.mpr (dist_two hc (fun e => vr (i:=0) (Nat.zero_le _) ir
      (by omega) (p.getVert_zero.trans e)) no adj edge),p.getVert_mem_support i⟩
  have d2 : p.getVert 2∈D := mkD (by omega) (by omega) nTwo first
    (p.adj_getVert_succ (i:=1) (by omega))
  let A := (range 12).filter (fun i => G.Adj a (p.getVert i))
  have memA {i : ℕ} : i∈A ↔ i<12 ∧ G.Adj a (p.getVert i) := by simp [A]
  have sa : A.Nonempty := ⟨1,memA.mpr ⟨by omega,first⟩⟩
  let t := A.max' sa
  have tm : t∈A := max'_mem A sa
  have tb : t≤10 := by
    have b := memA.mp tm
    by_contra! big
    have eq : t=11 := by omega
    have q := b.2
    rw [eq,←len,p.getVert_length] at q
    exact na q
  have tmax {i : ℕ} (h : i∈A) : i≤t := le_max' A i h
  have injectA : (A.image p.getVert).card=A.card := by
    apply card_image_iff.mpr
    intro u hu v hv e
    have ur : u<12 := (memA.mp hu).1
    have vv : v<12 := (memA.mp hv).1
    exact hp.1.getVert_injOn (show u≤p.length by omega) (show v≤p.length by omega) e
  have allAdj : G.neighborFinset a ⊆ A.image p.getVert := by
    intro z zm
    have az := (mem_neighborFinset G a z).mp zm
    have zp : z∈p.support := Classical.byContradiction (fun e => (no_endpoints hp e).1 az.symm)
    obtain ⟨k,ke,kp⟩ := mem_support_iff_exists_getVert.mp zp
    exact mem_image.mpr ⟨k,memA.mpr ⟨by omega,ke.symm ▸ az⟩,ke⟩
  have amin : 4≤A.card := by
    have q := card_le_card allAdj
    rw [injectA,card_neighborFinset_eq_degree] at q
    omega
  have tge : 5≤t := by
    by_contra! low
    have aa : A⊆({1,3,4}:Finset ℕ) := by
      intro v vm
      have vl : v≤t := tmax vm
      have vlt : v<5 := lt_of_le_of_lt vl low
      have va := (memA.mp vm).2
      by_cases n0 : v=0
      · exact False.elim (aA (n0 ▸ va))
      by_cases n2 : v=2
      · exact False.elim (nTwo (n2 ▸ va))
      have vc : v=1 ∨ v=3 ∨ v=4 := by omega
      simpa using vc
    have c := card_le_card aa
    have c3 : ( {1,3,4}:Finset ℕ).card=3 := by decide
    omega
  have dt : p.getVert (t+1)∈D := by
    have no : ¬G.Adj a (p.getVert (t+1)) := fun h => by
      have := tmax (memA.mpr ⟨by omega,h⟩)
      omega
    exact mkD (by omega) (by omega) no (memA.mp tm).2 (p.adj_getVert_succ (i:=t) (by omega))
  have deq : D=({p.getVert 2,p.getVert (t+1)}:Finset V) := by
    symm
    apply eq_of_subset_of_card_le
    · intro z hz
      exact (mem_insert.mp hz).elim (fun e => e.symm ▸ d2) (fun e => (mem_singleton.mp e).symm ▸ dt)
    · rw [card_insert_of_not_mem (by
          simpa using vr (i:=2) (j:=t+1) (by omega) (by omega) (by omega)),card_singleton]
      omega
  have back (k : ℕ) (r : 3≤k) (kt : k≤t) : G.Adj a (p.getVert k) := by
    let P := fun n : ℕ => 3≤t-n → G.Adj a (p.getVert (t-n))
    have yes : ∀ n,P n := by
      intro n
      induction n with
      | zero => intro _; simpa using (memA.mp tm).2
      | succ n ih =>
          intro ge
          have r' : 3≤t-n := by
            change 3≤t-(n+1) at ge
            omega
          have old := ih r'
          by_cases yes : G.Adj a (p.getVert (t-(n+1)))
          · exact yes
          exfalso
          have e : t-n = t-(n+1)+1 := by
            change 3≤t-(n+1) at ge
            omega
          have zz : p.getVert (t-(n+1))∈D :=
            mkD (by change 3≤t-(n+1) at ge; omega) (by omega) yes old
              (by rw [e]; exact (p.adj_getVert_succ (i:=t-(n+1)) (by omega)).symm)
          rw [deq] at zz
          rcases mem_insert.mp zz with o|o
          · exact vr (i:=t-(n+1)) (j:=2) (by omega) (by omega)
              (by change 3≤t-(n+1) at ge; omega) o
          · exact vr (i:=t-(n+1)) (j:=t+1) (by omega) (by omega)
              (by omega) (mem_singleton.mp o)
    have k' : t-(t-k)=k := by omega
    have eq := yes (t-k)
    simp only [P,k'] at eq
    exact eq r
  have ee : t≠10 := by
    intro eq
    have dis : Disjoint (LeftMarks p∪RightMarks p) (∅:Finset ℕ) := by simp
    have bd := mark_length hp xo (p.getVert_mem_support 1) (pin_data h1).2 ∅ (empty_subset _) dis
    have ss : ({1,3,4,5,6,7,8,9,10}:Finset ℕ)⊆A := by
      intro v vm
      have q : v=1 ∨ (3≤v ∧ v≤10) := by
        simp only [mem_insert,mem_singleton] at vm
        omega
      rcases q with rfl|h
      · exact memA.mpr ⟨by omega,first⟩
      · exact memA.mpr ⟨by omega,back v h.1 (by omega)⟩
    have size := card_le_card ss
    norm_num at size
    -- The indexed left neighborhood is injective and contained in the actual neighborhood.
    have sub : A.image p.getVert⊆G.neighborFinset a := by
      intro v vm
      obtain ⟨i,im,rfl⟩ := mem_image.mp vm
      exact (mem_neighborFinset G a _).mpr (memA.mp im).2
    have ag := card_le_card sub
    rw [injectA,card_neighborFinset_eq_degree] at ag
    simp at bd
    omega
  have nbD : b∉D := by
    intro h
    rw [deq] at h
    rcases mem_insert.mp h with hh|hh
    · exact vr (i:=p.length) (j:=2) le_rfl (by omega) (by omega) (p.getVert_length.trans hh)
    · exact vr (i:=p.length) (j:=t+1) le_rfl (by omega) (by omega)
        (p.getVert_length.trans (mem_singleton.mp hh))

  refine ⟨t,tge,by omega,back,?_,na,?_⟩
  · intro k kr h
    have kA : k∈A := memA.mpr ⟨by omega,h⟩
    have kl : k≤t := tmax kA
    have n0 : k≠0 := fun e => aA (e ▸ h)
    have n2 : k≠2 := fun e => nTwo (e ▸ h)
    omega
  · intro d
    exact nbD (mem_filter.mpr ⟨d,p.end_mem_support⟩)
#print axioms length_eleven_left_block_of_small_path_d2


private theorem length_eleven_three_off_left_chord
    (hc : G.Connected) (even : ∀ v,(EvenFrom G v).card≤5)
    (conn : ∀ S : Finset V,S.card<2 → (G.induce ((↑S : Set V)ᶜ)).Connected)
    (degree : ∀ u v : V,u≠v → 4≤G.degree u ∨ 4≤G.degree v)
    {a b x y : V} {p : G.Walk a b} (hp : EdgeOptimal p)
    (ah : 4≤G.degree a) (bh : 4≤G.degree b) (len : p.length=11)
    (xo : x∉p.support) (yo : y∉p.support) (xy : x≠y)
    (h1 : 1∈Pins p x) (y1 : 1∈Pins p y) {j : ℕ} (hj : j∈Pins p x) (gg : 4≤j) :
    (j≠10 → G.Adj a (p.getVert (j-1))) ∧
    (j=10 → G.Adj b (p.getVert 7) ∧ G.Adj b (p.getVert 8)) := by
  classical
  let D := DistanceTwo G a
  let P := D.filter (· ∈ p.support)
  let Q := D.filter (· ∉ p.support)
  have px1 := (pin_data h1).2
  have first : G.Adj a (p.getVert 1) := by simpa using p.adj_getVert_succ (i:=0) (by omega)
  have dist {z : V} (zo : z∉p.support) (hp1 : 1∈Pins p z) : z∈Q :=
    mem_filter.mpr ⟨mem_distanceTwo.mpr (dist_two hc (fun e => zo (e ▸ p.start_mem_support))
      (fun e => (no_endpoints hp.1 zo).1 e.symm) first (pin_data hp1).2.symm),zo⟩
  have left2 : 2≤Q.card := one_lt_card.mpr ⟨x,dist xo h1,y,dist yo y1,xy⟩
  have eq := filter_card_add_filter_neg_card_eq_card (s:=D) (· ∈ p.support)
  have cap : D.card≤4 := distanceTwo_le_of_even 4 a (even a)
  have small : P.card≤2 := by
    change P.card+Q.card=D.card at eq
    omega
  obtain ⟨t,tge,tle,back,all,na,nb⟩ := length_eleven_left_block_of_small_path_d2 hc hp.1 ah bh len xo h1 small
  have rm {k : ℕ} (ak : G.Adj a (p.getVert k)) : k∉RightMarks p := by
    intro kr
    have ab : a≠b := fun e => by
      have ee := hp.1.1.getVert_injOn (show 0≤p.length by omega) (show p.length≤p.length from le_rfl)
        (p.getVert_zero.trans (e.trans p.getVert_length.symm))
      omega
    exact nb (mem_distanceTwo.mpr (dist_two hc ab na ak ((mem_filter.mp kr).2).symm))
  have rmPred {k : ℕ} (kr : k<p.length) (ak : G.Adj a (p.getVert (k+1))) : k∉RightMarks p := by
    intro bk
    exact not_adj_both_end_marks hp.1 xo (p.getVert_mem_support 1) px1 kr ak (mem_filter.mp bk).2
  let S : Finset ℕ := {6,7,8,9,10}
  have Sc : S.card=5 := by decide
  have sub : RightMarks p ⊆ S := by
    intro k km
    have kr := mem_range.mp (mem_filter.mp km).1
    have beg : 6≤k := by
      by_contra! no
      have c : k=0 ∨ k=1 ∨ k=2 ∨ (3≤k ∧ k≤5) := by omega
      rcases c with rfl|rfl|rfl|c
      · exact rmPred (by omega) first km
      · exact rm first km
      · exact rmPred (by omega) (back 3 (by omega) (by omega)) km
      · exact rm (back k c.1 (c.2.trans tge)) km
    have kk : k=6 ∨ k=7 ∨ k=8 ∨ k=9 ∨ k=10 := by omega
    simpa [S] using kk
  have jlt := (pin_data hj).1
  constructor
  · intro j10
    by_contra no
    have jt : t<j-1 := by
      by_contra! H
      exact no (back _ (by omega) H)
    have ja : ¬G.Adj a (p.getVert j) := by
      intro e
      have fin := all j jlt.le e
      omega
    have hn : j-1∉LeftMarks p∪RightMarks p := (mark_holes_of_pin_and_missing_endpoint hp.1 xo hj).1 ja
    have bb := (length_eleven_two_pin_hits_boundary hc even conn degree hp ah bh len xo h1 hj (by omega)).2 j10
    have hj9 : j≤9 := by omega
    have hj7 : 7≤j := by omega
    let T : Finset ℕ := {j-1,j}
    have Tsub : T⊆S := by
      intro k km
      have k' : k=j-1 ∨ k=j := by simpa [T] using km
      have bt : k=6 ∨ k=7 ∨ k=8 ∨ k=9 ∨ k=10 := by omega
      simpa [S] using bt
    have Tcard : T.card=2 := by simp [T,show j-1≠j by omega]
    have disjointR : RightMarks p ⊆ S\T := by
      intro k km
      refine mem_sdiff.mpr ⟨sub km,?_⟩
      intro h
      have k' : k=j-1 ∨ k=j := by simpa [T] using h
      rcases k' with rfl|rfl
      · exact hn (mem_union.mpr (.inr km))
      · exact bb.2 (mem_union.mpr (.inr km))
    have c := card_le_card disjointR
    have e := card_sdiff_add_card_eq_card Tsub
    rw [card_rightMarks hp.1] at c
    omega
  · intro j10
    have ne : 9∉RightMarks p := fun h =>
      end_not_adj_pin_predecessor hp.1 xo hj (by
        rw [j10]
        exact (mem_filter.mp h).2)
    have csub : RightMarks p ⊆ (S.erase 9) := fun k km =>
      mem_erase.mpr ⟨fun e => ne (e ▸ km),sub km⟩
    have eqR := eq_of_subset_of_card_le csub (by
      have n : (S.erase 9).card=4 := by decide
      rw [n,card_rightMarks hp.1]
      exact bh)
    have r7 : 7∈RightMarks p := by rw [eqR]; decide
    have r8 : 8∈RightMarks p := by rw [eqR]; decide
    exact ⟨(mem_filter.mp r7).2,(mem_filter.mp r8).2⟩
#print axioms length_eleven_three_off_left_chord


namespace OffThree15
abbrev Vertex := Fin 15

def dir (j : ℕ) (u v : Vertex) : Bool :=
  let a := u.val
  let b := v.val
  decide (b=a+1 ∧ b≤11) ||
  decide (12≤a ∧ a<b) ||
  decide ((a=1 ∨ a=j) ∧ (b=12 ∨ b=13)) ||
  decide ((j=10 ∧ (a=7 ∨ a=8) ∧ b=11) ∨ (j≠10 ∧ a=0 ∧ b=j-1))

def edge (j : ℕ) (u v : Vertex) : Bool := dir j u v || dir j v u

def schedule (j : ℕ) : List Vertex :=
  if j=10 then [0,1,2,3,4,5,6,7,11,8,9,10,12,14,13]
  else [0] ++ (((List.range (j-1)).reverse).map (fun v => Fin.ofNat' 15 (v+1))) ++
    [12,14,13] ++ ((List.range (12-j)).map (fun v => Fin.ofNat' 15 (j+v)))

theorem checked (j : ℕ) (low : 4≤j) (high : j≤10) :
    (schedule j).Nodup ∧ (∀ k : Vertex,k∈schedule j) ∧
    (schedule j).Chain' (fun u v => edge j u v=true) := by
  have c : j=4 ∨ j=5 ∨ j=6 ∨ j=7 ∨ j=8 ∨ j=9 ∨ j=10 := by omega
  rcases c with rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> decide +kernel
#print axioms checked
end OffThree15


private theorem three_off_labeled_clique
    (degree : ∀ u v : V,u≠v → 4≤G.degree u ∨ 4≤G.degree v)
    {a b x : V} {p : G.Walk a b} (xo : x∉p.support)
    (off : ((univ : Finset V)\p.support.toFinset).card=3) :
    ∃ y z : V, y∉p.support ∧ z∉p.support ∧ x≠y ∧ x≠z ∧ y≠z ∧
      4≤G.degree y ∧ ((univ : Finset V)\p.support.toFinset)={x,y,z} := by
  classical
  let O := (univ : Finset V)\p.support.toFinset
  have out {w : V} : w∈O ↔ w∉p.support := by simp [O]
  have xO := out.mpr xo
  have O3 : O.card=3 := off
  have c := card_erase_of_mem xO
  obtain ⟨u,uR,v,vR,ne⟩ := one_lt_card.mp (show 1<(O.erase x).card by omega)
  obtain ⟨y,z,yr,zr,yz,yhi⟩ : ∃ y z : V,
      y∈O.erase x ∧ z∈O.erase x ∧ y≠z ∧ 4≤G.degree y := by
    rcases degree u v ne with h|h
    · exact ⟨u,v,uR,vR,ne,h⟩
    · exact ⟨v,u,vR,uR,ne.symm,h⟩
  obtain ⟨yx,yO⟩ := mem_erase.mp yr
  obtain ⟨zx,zO⟩ := mem_erase.mp zr
  refine ⟨y,z,out.mp yO,out.mp zO,yx.symm,zx.symm,yz,yhi,?_⟩
  symm
  apply eq_of_subset_of_card_le
  · intro t tm
    rcases mem_insert.mp tm with rfl|tm
    · exact xO
    rcases mem_insert.mp tm with rfl|tm
    · exact yO
    · exact (mem_singleton.mp tm).symm ▸ zO
  · rw [O3,card_insert_of_not_mem (by simp [yx.symm,zx.symm]),
      card_insert_of_not_mem (by simp [yz]),card_singleton]

private theorem length_eleven_three_off_labeled_path
    {a b x y z : V} {p : G.Walk a b} (hp : IsLongest p) (len : p.length=11)
    (os : ((univ : Finset V)\p.support.toFinset)={x,y,z})
    (xy : x≠y) (xz : x≠z) (yz : y≠z)
    (clique : ∀ z∉p.support,∀ w∉p.support,z≠w → G.Adj z w)
    {j : ℕ} (jlo : 4≤j) (jhi : j≤10)
    (px1 : G.Adj x (p.getVert 1)) (pxj : G.Adj x (p.getVert j))
    (py1 : G.Adj y (p.getVert 1)) (pyj : G.Adj y (p.getVert j))
    (la : j≠10 → G.Adj a (p.getVert (j-1)))
    (rb : j=10 → G.Adj b (p.getVert 7) ∧ G.Adj b (p.getVert 8)) :
    ∃ a b : V, ∃ p : G.Walk a b,p.IsPath ∧ ∀ v,v∈p.support := by
  classical
  let O := (univ : Finset V)\p.support.toFinset
  have os' : O={x,y,z} := os
  have out {u : V} : u∈O ↔ u∉p.support := by simp [O]
  have xo : x∉p.support := out.mp (by simp [os'])
  have yo : y∉p.support := out.mp (by simp [os'])
  have zo : z∉p.support := out.mp (by simp [os'])
  let φ (k : Fin 15) : V := if k.val=12 then x else if k.val=13 then y else
    if k.val=14 then z else p.getVert k.val
  have value {k : Fin 15} (h : k.val≤11) : φ k=p.getVert k.val := by
    simp [φ,show k.val≠12 by omega,show k.val≠13 by omega,show k.val≠14 by omega]
  have classify (k : Fin 15) : k.val≤11 ∨ k=12 ∨ k=13 ∨ k=14 := by
    by_cases h11 : k.val=12
    · exact .inr (.inl (Fin.ext h11))
    by_cases h12 : k.val=13
    · exact .inr (.inr (.inl (Fin.ext h12)))
    by_cases h13 : k.val=14
    · exact .inr (.inr (.inr (Fin.ext h13)))
    exact .inl (by omega)
  have val12 : φ 12=x := rfl
  have val13 : φ 13=y := rfl
  have val14 : φ 14=z := rfl
  have conflict {r : V} {k : ℕ} (ro : r∉p.support) (e : p.getVert k=r) : False :=
    ro (e ▸ p.getVert_mem_support k)
  have lab_inj : Function.Injective φ := by
    intro k l eq
    rcases classify k with kh|kh|kh|kh <;> rcases classify l with lh|lh|lh|lh
    · exact Fin.ext (hp.1.getVert_injOn (show k.val≤p.length by omega)
        (show l.val≤p.length by omega) ((value kh).symm.trans (eq.trans (value lh))))
    all_goals try subst k
    all_goals try subst l
    all_goals try rfl
    all_goals try rw [value kh] at eq
    all_goals try rw [value lh] at eq
    all_goals simp only [val12,val13,val14] at eq
    all_goals exfalso
    all_goals first | contradiction | exact xy eq.symm | exact xz eq.symm | exact yz eq.symm | exact conflict xo eq | exact conflict xo eq.symm | exact conflict yo eq | exact conflict yo eq.symm | exact conflict zo eq | exact conflict zo eq.symm

  have phi_sur : Function.Surjective φ := by
    intro w
    by_cases h : w∈p.support
    · obtain ⟨k,kw,kl⟩ := mem_support_iff_exists_getVert.mp h
      exact ⟨⟨k,by omega⟩,(value (show k≤11 by omega)).trans kw⟩
    · have q := out.mpr h
      rw [os',mem_insert,mem_insert,mem_singleton] at q
      rcases q with rfl|rfl|rfl
      · exact ⟨12,val12⟩
      · exact ⟨13,val13⟩
      · exact ⟨14,val14⟩
  have compat (u v : Fin 15) (h : OffThree15.dir j u v=true) : G.Adj (φ u) (φ v) := by
    have ul := u.isLt
    have vl := v.isLt
    simp only [OffThree15.dir,Bool.or_eq_true,decide_eq_true_eq] at h
    rcases h with (((l|c)|q)|q)
    · rw [value (show u.val≤11 by omega),value l.2,l.1]
      exact p.adj_getVert_succ (by omega)
    · apply clique
      · rcases classify u with he|he|he|he
        · omega
        · exact he.symm ▸ xo
        · exact he.symm ▸ yo
        · exact he.symm ▸ zo
      · rcases classify v with he|he|he|he
        · omega
        · exact he.symm ▸ xo
        · exact he.symm ▸ yo
        · exact he.symm ▸ zo
      · intro same
        have vv := congrArg Fin.val (lab_inj same)
        omega
    · have upr : u.val≤11 := by rcases q.1 with hh|hh <;> omega
      rcases q.2 with v12|v13
      · have e : v=12 := Fin.ext v12
        rw [value upr,e,val12]
        exact (q.1.elim (fun h => h.symm ▸ px1) (fun h => h.symm ▸ pxj)).symm
      · have e : v=13 := Fin.ext v13
        rw [value upr,e,val13]
        exact (q.1.elim (fun h => h.symm ▸ py1) (fun h => h.symm ▸ pyj)).symm
    · rcases q with ⟨je,u7,v11⟩|⟨jne,u0,vj⟩
      · have inrange : u.val≤11 := by rcases u7 with h|h <;> omega
        rw [value inrange,value (show v.val≤11 by omega),v11,←len,p.getVert_length]
        rcases u7 with rflU|rflU
        · rw [rflU]; exact (rb je).1.symm
        · rw [rflU]; exact (rb je).2.symm
      · rw [value (show u.val≤11 by omega),value (show v.val≤11 by omega),u0,p.getVert_zero,vj]
        exact la jne
  obtain ⟨nod,cover,chain⟩ := OffThree15.checked j jlo jhi
  letI : Nonempty V := ⟨a⟩
  apply hamilton_of_labeled_chain φ lab_inj phi_sur _ nod cover
  apply List.Chain'.imp (fun u v e => ?_) chain
  simp only [OffThree15.edge,Bool.or_eq_true] at e
  exact e.elim (compat u v) (fun e => (compat v u e).symm)
#print axioms length_eleven_three_off_labeled_path


theorem traceable_if_three_off_order_fifteen
    (hc : G.Connected) (even : ∀ v,(EvenFrom G v).card≤5)
    (conn : ∀ S : Finset V,S.card<2 → (G.induce ((↑S : Set V)ᶜ)).Connected)
    (degree : ∀ u v : V,u≠v → 4≤G.degree u ∨ 4≤G.degree v)
    {a b : V} {p : G.Walk a b} (hp : EdgeOptimal p)
    (ah : 4≤G.degree a) (bh : 4≤G.degree b) (len : p.length=11)
    (off : ((univ : Finset V)\p.support.toFinset).card=3) :
    ∃ a b : V, ∃ p : G.Walk a b,p.IsPath ∧ ∀ v,v∈p.support := by
  classical
  obtain ⟨x,i,j,xo,xh,hi,hj,gap,C,_,H⟩ := three_off_same_ports hc even conn degree hp ah bh off
  obtain ⟨y,z,yo,zo,xy,xz,yz,yh,os⟩ := three_off_labeled_clique degree xo off
  have hyi : i∈Pins p y := by rw [H y yo yh]; simp
  have hyj : j∈Pins p y := by rw [H y yo yh]; simp
  have J := (pin_data hj).1
  have I := pin_pos hp.1 xo hi
  have border := (length_eleven_two_pin_hits_boundary hc even conn degree hp ah bh len xo hi hj gap).1
  have finish {a' b' : V} {q : G.Walk a' b'} (hq : EdgeOptimal q)
      (ha' : 4≤G.degree a') (hb' : 4≤G.degree b') (lq : q.length=11)
      (oq : ((univ : Finset V)\q.support.toFinset)={x,y,z})
      (xq : x∉q.support) (yq : y∉q.support)
      {k : ℕ} (hk : 4≤k) (ku : k≤10)
      (x1 : 1∈Pins q x) (xk : k∈Pins q x) (y1 : 1∈Pins q y) (yk : k∈Pins q y)
      (clique : ∀ z∉q.support,∀ w∉q.support,z≠w → G.Adj z w) :
      ∃ a b : V, ∃ r : G.Walk a b,r.IsPath ∧ ∀ v,v∈r.support := by
    obtain ⟨left,right⟩ := length_eleven_three_off_left_chord hc even conn degree hq ha' hb' lq
      xq yq xy x1 y1 xk hk
    exact length_eleven_three_off_labeled_path hq.1 lq oq xy xz yz clique hk ku
      (pin_data x1).2 (pin_data xk).2 (pin_data y1).2 (pin_data yk).2 left right
  rcases border with e|e
  · subst i
    exact finish hp ah bh len os xo yo (by omega) (by omega) hi hj hyi hyj C
  · subst j
    have ep : EdgeOptimal p.reverse := same_support_optimal hp (reverse_long hp.1) (by intro z; simp)
    have lq : p.reverse.length=11 := by simpa using len
    have oq : ((univ : Finset V)\p.reverse.support.toFinset)={x,y,z} := by
      rw [support_reverse]
      simpa using os
    have xc1 : 1∈Pins p.reverse x := by simpa [len] using reverse_pin hp.1 xo hj
    have yc1 : 1∈Pins p.reverse y := by simpa [len] using reverse_pin hp.1 yo hyj
    have hxi : 11-i∈Pins p.reverse x := by simpa [len] using reverse_pin hp.1 xo hi
    have hyi : 11-i∈Pins p.reverse y := by simpa [len] using reverse_pin hp.1 yo hyi
    exact finish ep bh ah lq oq (by simpa using xo) (by simpa using yo) (by omega) (by omega)
      xc1 hxi yc1 hyi (by simpa only [support_reverse,List.mem_reverse] using C)
#print axioms traceable_if_three_off_order_fifteen
