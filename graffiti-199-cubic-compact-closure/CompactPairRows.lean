set_option maxHeartbeats 8000000 in
private theorem pairCoverage (k : Fin 6) :
    ∀ (i j : Fin (profiles k).length) (b : Bool),
      let m := (profiles k).get i
      let n := (profiles k).get j
      contact m 0 = true → contact n 6 = true →
        (pairCert k.val m.val n.val b).Valid (pairEdge k m n b) (fun P _ => PairRoute (pairEdge k m n b) P)
          (m = boundary k ∧ n = boundary k ∧ b = true) := by
  fin_cases k <;> decide

theorem paired_extension (k : Fin 6) (m n : Profile) (b : Bool)
    (hm : m ∈ profiles k) (hn : n ∈ profiles k)
    (left : contact m 0 = true) (right : contact n 6 = true) :
    (∃ T, SixTree (pairEdge k m n b) T) ∨ (∃ P, PairRoute (pairEdge k m n b) P) ∨
      (m = boundary k ∧ n = boundary k ∧ b = true) := by
  obtain ⟨i,rfl⟩ := List.mem_iff_get.mp hm
  obtain ⟨j,rfl⟩ := List.mem_iff_get.mp hn
  have valid := pairCoverage k i j b left right
  cases hC : pairCert k.val ((profiles k).get i).val ((profiles k).get j).val b with
  | tree T =>
    rw [hC] at valid
    exact Or.inl ⟨T,valid⟩
  | route P front =>
    rw [hC] at valid
    exact Or.inr (Or.inl ⟨P,valid⟩)
  | pass =>
    rw [hC] at valid
    exact Or.inr (Or.inr valid)

#print axioms paired_extension

end Graffiti199Depleted.CompactOmission
