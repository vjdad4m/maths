private theorem oneCoverage (k : Fin 6) : ∀ m : Profile, contact m (mate k) = false →
    m ∈ profiles k ∨ SixTree (oneEdge k m) (oneOrder k.val m.val) := by
  fin_cases k <;> decide

theorem single_extension (k : Fin 6) (m : Profile) (off : contact m (mate k) = false) :
    m ∈ profiles k ∨ ∃ T, SixTree (oneEdge k m) T := by
  rcases oneCoverage k m off with good|tree
  · exact Or.inl good
  · exact Or.inr ⟨_,tree⟩

#print axioms single_extension

