private theorem clauses33_valid (m : Fin 3) :
    ∀ i : Fin (clauses33 m).length, ((clauses33 m).get i).Valid (family33 m).pattern := by
  fin_cases m <;> decide

private theorem covered33_valid (m : Fin 3) :
    (covered33 m).Valid (family33 m).pattern
      (ClauseOrRow (family33 m) (clauses33 m) (residues33 m)) 0 0 := by
  fin_cases m <;> decide

theorem classification33 (m : Fin 3) (row : ℕ) :
    (∃ T, SixTree ((family33 m).pattern.edge row) T) ∨
      ∃ tag ∈ residues33 m, ∀ i j,
        (family33 m).pattern.edge row i j = (family33 m).pattern.edge tag i j :=
  classified_with_clauses (clauses33_valid m) (covered33_valid m) row

theorem family33_consistent (m : Fin 3) : Consistent layout33 m (family33 m) := by
  fin_cases m <;> decide

