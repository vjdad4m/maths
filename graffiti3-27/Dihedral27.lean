import Std
namespace GraffitiThree27
set_option maxHeartbeats 10000000
set_option maxRecDepth 10000

abbrev D := Fin 32 × Bool

def rot (n : Int) : Fin 32 := ⟨(n % 32).toNat, by omega⟩

theorem val_rot (n : Int) : ((rot n).val : Int) = n % 32 := by
  change (((n % 32).toNat : Nat) : Int) = n % 32
  omega

def one : D := (0, false)
def mul (x y : D) : D :=
  (rot ((x.1.val : Int) + if x.2 then -(y.1.val : Int) else (y.1.val : Int)),
   xor x.2 y.2)
def inv (x : D) : D := (rot (if x.2 then (x.1.val : Int) else -(x.1.val : Int)), x.2)

theorem mul_assoc (x y z : D) : mul (mul x y) z = mul x (mul y z) := by
  obtain ⟨x,b⟩ := x
  obtain ⟨y,c⟩ := y
  obtain ⟨z,d⟩ := z
  cases b <;> cases c <;> cases d <;> simp [mul, val_rot] <;>
    (apply Fin.ext; simp [rot]; omega)

theorem one_mul (x : D) : mul one x = x := by
  obtain ⟨x,b⟩ := x
  cases b <;> simp [mul, one] <;> apply Fin.ext <;> simp [rot] <;> omega
theorem mul_one (x : D) : mul x one = x := by
  obtain ⟨x,b⟩ := x
  cases b <;> simp [mul, one] <;> apply Fin.ext <;> simp [rot] <;> omega
theorem inv_mul (x : D) : mul (inv x) x = one := by
  obtain ⟨x,b⟩ := x
  cases b <;> simp [mul, one, inv, val_rot] <;> apply Fin.ext <;> simp [rot] <;> omega
theorem mul_inv (x : D) : mul x (inv x) = one := by
  obtain ⟨x,b⟩ := x
  cases b <;> simp [mul, one, inv, val_rot] <;> apply Fin.ext <;> simp [rot] <;> omega


/-- A finite set has exactly n elements when it is in bijection with Fin n. -/
structure Cardinal (T : Type) (n : Nat) where
  index : T → Fin n
  atIndex : Fin n → T
  rightInv : ∀ i, index (atIndex i) = i
  leftInv : ∀ x, atIndex (index x) = x

def elementIndex (x : D) : Fin 64 :=
  ⟨2*x.1.val + if x.2 then 1 else 0, by
    obtain ⟨v,b⟩ := x; cases b <;> simp <;> omega⟩

def fromIndex (i : Fin 64) : D :=
  (⟨i.val / 2, by omega⟩, decide (i.val % 2 = 1))

def orderExact : Cardinal D 64 where
  index := elementIndex
  atIndex := fromIndex
  rightInv i := by
    apply Fin.ext
    simp [elementIndex, fromIndex]
    split <;> omega
  leftInv x := by
    obtain ⟨v,b⟩ := x
    cases b <;> simp [elementIndex, fromIndex]
    all_goals first | omega | (apply Fin.ext; simp; omega)

def conjugate (g x : D) : D := mul (mul g x) (inv g)
def IsConj (x y : D) : Prop := ∃ g : D, conjugate g x = y
def commutator (x y : D) : D := mul (mul (mul x y) (inv x)) (inv y)

/-- The subgroup generated by all commutators, i.e. the derived subgroup. -/
inductive DerivedOf {T : Type} (id : T) (f : T → T → T) (i : T → T) : T → Prop
  | ident : DerivedOf id f i id
  | comm (x y : T) : DerivedOf id f i (f (f (f x y) (i x)) (i y))
  | times {x y : T} : DerivedOf id f i x → DerivedOf id f i y → DerivedOf id f i (f x y)
  | inverse {x : T} : DerivedOf id f i x → DerivedOf id f i (i x)

abbrev Derived := DerivedOf one mul inv

def parity (x : D) : Nat := x.1.val % 2
def evenRotation (x : D) : Prop := x.2 = false ∧ parity x = 0

theorem derived_sound {x : D} (hx : Derived x) : evenRotation x := by
  induction hx with
  | ident => exact ⟨rfl,rfl⟩
  | comm x y =>
    obtain ⟨x,b⟩ := x
    obtain ⟨y,c⟩ := y
    cases b <;> cases c <;> simp [evenRotation, parity, commutator, mul, inv, val_rot, rot] <;> omega
  | @times x y _ _ hx hy =>
    obtain ⟨x,b⟩ := x
    obtain ⟨y,c⟩ := y
    simp [evenRotation, parity] at hx hy
    obtain ⟨rfl,hx⟩ := hx
    obtain ⟨rfl,hy⟩ := hy
    simp [evenRotation, parity, mul, rot]
    omega
  | @inverse x _ hx =>
    obtain ⟨x,b⟩ := x
    simp [evenRotation, parity] at hx
    obtain ⟨rfl,hx⟩ := hx
    simp [evenRotation, parity, inv, rot]
    omega

theorem derived_complete {x : D} (hx : evenRotation x) : Derived x := by
  obtain ⟨x,b⟩ := x
  simp [evenRotation, parity] at hx
  obtain ⟨rfl,h⟩ := hx
  let witness : D := (rot (-(x.val : Int)/2), false)
  have hm : commutator (0,true) witness = (x,false) := by
    simp [witness, commutator, mul, inv, val_rot]
    apply Fin.ext
    simp [rot]
    omega
  rw [← hm]
  exact DerivedOf.comm _ _

def SameCoset (x y : D) : Prop := Derived (mul x (inv y))

theorem coset_iff (x y : D) : SameCoset x y ↔ x.2 = y.2 ∧ parity x = parity y := by
  change Derived _ ↔ _
  rw [show ∀ z : D, Derived z ↔ evenRotation z from fun _ => ⟨derived_sound, derived_complete⟩]
  obtain ⟨x,b⟩ := x
  obtain ⟨y,c⟩ := y
  cases b <;> cases c <;> simp [evenRotation, parity, mul, inv, val_rot, rot] <;> omega

/-- Labels are exactly quotient classes: equality of labels iff the given relation,
and every label occurs. This is a finite-set cardinality certificate for the quotient. -/
structure CountClasses {T : Type} (R : T → T → Prop) (n : Nat) where
  label : T → Fin n
  rep : Fin n → T
  surjective : ∀ i, label (rep i) = i
  identifies : ∀ x y, R x y ↔ label x = label y

def cosetLabel (x : D) : Fin 4 :=
  ⟨2 * parity x + if x.2 then 1 else 0, by
    obtain ⟨x,b⟩ := x
    cases b <;> simp [parity] <;> omega⟩

def quotientExact : CountClasses SameCoset 4 where
  label := cosetLabel
  rep i := (⟨i.val/2, by omega⟩, decide (i.val%2=1))
  surjective i := by
    apply Fin.ext
    simp [cosetLabel, parity]
    split <;> omega
  identifies x y := by
    rw [coset_iff]
    obtain ⟨x,b⟩ := x
    obtain ⟨y,c⟩ := y
    cases b <;> cases c <;> simp [cosetLabel, parity, Fin.ext_iff] <;> omega

def conjLabel (x : D) : Fin 19 :=
  ⟨if x.2 then 17 + x.1.val % 2 else min x.1.val ((32 - x.1.val)%32), by
    obtain ⟨x,b⟩ := x; cases b <;> simp <;> omega⟩

def rep (i : Fin 19) : D :=
  (⟨if i.val < 17 then i.val else i.val - 17, by split <;> omega⟩, decide (17 ≤ i.val))

def conjugator (x : D) : D :=
  if x.2 then (rot (((x.1.val % 2 : Nat) - (x.1.val : Int))/2), false)
  else (0, decide (16 < x.1.val))

theorem label_surjective (i : Fin 19) : conjLabel (rep i) = i := by
  exact (by decide : ∀ j : Fin 19, conjLabel (rep j) = j) i

theorem label_preserved (g x : D) : conjLabel (conjugate g x) = conjLabel x := by
  have h : ∀ (i : Fin 32) (b : Bool) (j : Fin 32) (c : Bool),
      conjLabel (conjugate (i,b) (j,c)) = conjLabel (j,c) := by decide
  exact h g.1 g.2 x.1 x.2

theorem conjugator_works (x : D) : conjugate (conjugator x) x = rep (conjLabel x) := by
  have h : ∀ (i : Fin 32) (b : Bool),
      conjugate (conjugator (i,b)) (i,b) = rep (conjLabel (i,b)) := by decide
  exact h x.1 x.2

theorem inv_inv (g : D) : inv (inv g) = g := by
  have h : ∀ (i : Fin 32) (b : Bool), inv (inv (i,b)) = (i,b) := by decide
  exact h g.1 g.2

theorem inverse_conjugate (g x : D) : conjugate (inv g) (conjugate g x) = x := by
  simp only [conjugate, inv_inv]
  calc
    mul (mul (inv g) (mul (mul g x) (inv g))) g =
        mul (mul (mul (inv g) g) x) (mul (inv g) g) := by
      simp only [mul_assoc]
    _ = x := by simp only [inv_mul, one_mul, mul_one]

theorem inv_mul_rev (g h : D) : inv (mul g h) = mul (inv h) (inv g) := by
  calc
    inv (mul g h) = mul (inv (mul g h)) (mul (mul g h) (mul (inv h) (inv g))) := by
      rw [show mul (mul g h) (mul (inv h) (inv g)) = one by
        rw [mul_assoc g h, ← mul_assoc h (inv h), mul_inv h, one_mul, mul_inv], mul_one]
    _ = mul (inv h) (inv g) := by rw [← mul_assoc, inv_mul, one_mul]

theorem compose_conjugate (g h x : D) :
    conjugate (mul g h) x = conjugate g (conjugate h x) := by
  simp only [conjugate, inv_mul_rev, mul_assoc]

def conjugacyExact : CountClasses IsConj 19 where
  label := conjLabel
  rep := rep
  surjective := label_surjective
  identifies x y := by
    constructor
    · rintro ⟨g,rfl⟩
      exact (label_preserved g x).symm
    · intro hl
      refine ⟨mul (inv (conjugator y)) (conjugator x), ?_⟩
      rw [compose_conjugate, conjugator_works, hl, ← conjugator_works y, inverse_conjugate]

def IsTwoPower (n : Nat) : Prop := ∃ e : Nat, n = 2^e

/-- Largest power of 2 that divides the group order, equivalently the order
of a Sylow 2-subgroup by the Sylow theorem. For a finite 2-group the whole
group is a Sylow 2-subgroup. -/
def Sylow2Order (n s : Nat) : Prop :=
  IsTwoPower s ∧ s ∣ n ∧ ∀ t : Nat, IsTwoPower t → t ∣ n → t ≤ s

theorem sylowExact : Sylow2Order 64 64 := by
  refine ⟨⟨6,rfl⟩, Nat.dvd_refl _, ?_⟩
  intro t _ h
  exact Nat.le_of_dvd (by decide) h

def absDiff (a b : Nat) : Nat := (a-b)+(b-a)

/-- Exact negation of Graffiti³ #27 on the certified dihedral 2-group.
The inequality is cleared of denominators: k ≥ (7/16)|a−s|−4 iff
7|a−s| ≤ 16(k+4). -/
theorem counterexample :
    IsTwoPower 64 ∧ Sylow2Order 64 64 ∧ ¬ (7 * absDiff 4 64 ≤ 16 * (19+4)) := by
  exact ⟨⟨6,rfl⟩, sylowExact, by decide⟩

/-- A type equipped with actual group operations. Finiteness is witnessed by a
separate bijection; an arbitrary relation/table cannot qualify as a group. -/
structure GroupModel where
  T : Type
  id : T
  prod : T → T → T
  inverse : T → T
  associative : ∀ x y z, prod (prod x y) z = prod x (prod y z)
  left_id : ∀ x, prod id x = x
  right_id : ∀ x, prod x id = x
  left_inverse : ∀ x, prod (inverse x) x = id
  right_inverse : ∀ x, prod x (inverse x) = id

def dihedral : GroupModel where
  T := D
  id := one
  prod := mul
  inverse := inv
  associative := mul_assoc
  left_id := one_mul
  right_id := mul_one
  left_inverse := inv_mul
  right_inverse := mul_inv

def GroupConj (G : GroupModel) (x y : G.T) : Prop :=
  ∃ g : G.T, G.prod (G.prod g x) (G.inverse g) = y

def GroupCoset (G : GroupModel) (x y : G.T) : Prop :=
  DerivedOf G.id G.prod G.inverse (G.prod x (G.inverse y))

def Prime (p : Nat) : Prop := 2 ≤ p ∧ ∀ d : Nat, d ∣ p → d = 1 ∨ d = p
def IsPrimePower (n : Nat) : Prop := ∃ p e : Nat, Prime p ∧ n = p^e

theorem prime_two : Prime 2 := by
  refine ⟨by decide, ?_⟩
  intro d h
  have hle : d ≤ 2 := Nat.le_of_dvd (by decide) h
  have hpos : 0 < d := by
    by_cases hp : 0 < d
    · exact hp
    have : d = 0 := by omega
    subst d
    have : ¬ 0 ∣ 2 := by decide
    exact False.elim (this h)
  omega

/-- The Graffiti³ conjecture, with the natural odd-order convention s=0.
All orders/counts are expressed via bijective labels rather than chosen functions. -/
def Conjecture27 : Prop :=
  ∀ (G : GroupModel) (n k a s : Nat),
    Nonempty (Cardinal G.T n) → IsPrimePower n →
    Nonempty (CountClasses (GroupConj G) k) →
    Nonempty (CountClasses (GroupCoset G) a) →
    ((2 ∣ n ∧ Sylow2Order n s) ∨ (¬ 2 ∣ n ∧ s = 0)) →
    7 * absDiff a s ≤ 16 * (k+4)

theorem graffiti3_conj27_false : ¬ Conjecture27 := by
  intro h
  have hc := h dihedral 64 19 4 64 ⟨orderExact⟩ ⟨2,6,prime_two,rfl⟩
    ⟨conjugacyExact⟩ ⟨quotientExact⟩ (Or.inl ⟨by decide,sylowExact⟩)
  exact counterexample.2.2 hc

